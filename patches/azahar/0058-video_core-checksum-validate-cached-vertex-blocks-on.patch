From 33b4eeca3686c245faa07c2da386cc77fcb03b2b Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 13 Oct 2026 15:10:52 -0400
Subject: [PATCH] video_core: checksum-validate cached vertex blocks once per
 frame

Writes that bypass page tracking (HLE services, DMA, GPU downloads) could leave stale vertices in the persistent cache. Hash the source bytes of each live block at most once per frame (8 MiB budget); a mismatch drops the block and re-copies. Counts stale/unchecked in the log.
---
 ...previous-picture-while-pipelines-bui.patch | 134 ++++++++++++++++++
 src/tests/video_core/vertex_cache.cpp         |  51 +++++++
 .../renderer_opengl/gl_rasterizer.cpp         |  14 +-
 .../renderer_vulkan/vk_rasterizer.cpp         |  14 +-
 src/video_core/vertex_region_cache.h          |  58 ++++++--
 5 files changed, 258 insertions(+), 13 deletions(-)
 create mode 100644 patches/azahar/0001-vulkan-hold-the-previous-picture-while-pipelines-bui.patch

diff --git a/patches/azahar/0001-vulkan-hold-the-previous-picture-while-pipelines-bui.patch b/patches/azahar/0001-vulkan-hold-the-previous-picture-while-pipelines-bui.patch
new file mode 100644
index 0000000..a7f118d
--- /dev/null
+++ b/patches/azahar/0001-vulkan-hold-the-previous-picture-while-pipelines-bui.patch
@@ -0,0 +1,134 @@
+From 22017e880e79e9502ea0c60bb407da233d36c185 Mon Sep 17 00:00:00 2001
+From: Claude <noreply@anthropic.com>
+Date: Tue, 6 Oct 2026 21:34:35 -0400
+Subject: [PATCH] vulkan: hold the previous picture while pipelines build
+ instead of showing frames with missing scenery
+
+---
+ .../emu_window/libretro_window.cpp            | 35 +++++++++++++++++++
+ .../renderer_vulkan/vk_frame_state.h          | 10 ++++++
+ .../renderer_vulkan/vk_pipeline_cache.cpp     |  3 ++
+ .../renderer_vulkan/vk_rasterizer.cpp         |  8 ++---
+ 4 files changed, 52 insertions(+), 4 deletions(-)
+ create mode 100644 src/video_core/renderer_vulkan/vk_frame_state.h
+
+diff --git a/src/citra_libretro/emu_window/libretro_window.cpp b/src/citra_libretro/emu_window/libretro_window.cpp
+index 676d91e..477d31f 100644
+--- a/src/citra_libretro/emu_window/libretro_window.cpp
++++ b/src/citra_libretro/emu_window/libretro_window.cpp
+@@ -8,6 +8,7 @@
+ #include <libretro.h>
+ 
+ #include <algorithm>
++#include <chrono>
+ #include <cstring>
+ #include <vector>
+ #include "audio_core/audio_types.h"
+@@ -21,6 +22,9 @@
+ #include "video_core/renderer_opengl/gl_state.h"
+ #endif
+ #include "video_core/gpu.h"
++#ifdef ENABLE_VULKAN
++#include "video_core/renderer_vulkan/vk_frame_state.h"
++#endif
+ #include "video_core/renderer_software/renderer_software.h"
+ #include "video_core/renderer_software/sw_frame_skip.h"
+ 
+@@ -90,6 +94,37 @@ void EmuWindow_LibRetro::SwapBuffers() {
+     }
+     case Settings::GraphicsAPI::Vulkan: {
+ #ifdef ENABLE_VULKAN
++        // A frame with skipped draws (pipelines still building) is not shown; the
++        // frontend keeps the previous picture. Never hold longer than 3 s, and never
++        // before the first picture.
++        {
++            using Clock = std::chrono::steady_clock;
++            static Clock::time_point hold_since{};
++            static bool shown_any = false;
++            static bool gave_up = false;
++            static const void* last_window = nullptr;
++            if (last_window != this) { // new game: start clean
++                last_window = this;
++                hold_since = {};
++                shown_any = gave_up = false;
++            }
++            const bool incomplete = Vulkan::g_frame_incomplete.exchange(false);
++            const auto now = Clock::now();
++            if (incomplete && shown_any && !gave_up) {
++                if (hold_since == Clock::time_point{}) hold_since = now;
++                if (now - hold_since < std::chrono::seconds(3)) {
++                    LibRetro::UploadVideoFrame(nullptr, static_cast<unsigned>(width),
++                                               static_cast<unsigned>(height), 0);
++                    break;
++                }
++                gave_up = true; // show everything until a complete frame comes along
++            }
++            if (!incomplete) {
++                hold_since = {};
++                gave_up = false;
++            }
++            shown_any = true;
++        }
+         // Cursor is drawn inside the Vulkan render pass (RendererVulkan::DrawCursor)
+         LibRetro::UploadVideoFrame(RETRO_HW_FRAME_BUFFER_VALID, static_cast<unsigned>(width),
+                                    static_cast<unsigned>(height), 0);
+diff --git a/src/video_core/renderer_vulkan/vk_frame_state.h b/src/video_core/renderer_vulkan/vk_frame_state.h
+new file mode 100644
+index 0000000..64d1c21
+--- /dev/null
++++ b/src/video_core/renderer_vulkan/vk_frame_state.h
+@@ -0,0 +1,10 @@
++// ONYX: set when a draw of the current frame was skipped because its pipeline was
++// still being built. The libretro window then shows the previous picture instead of
++// a frame with missing scenery (the blue/empty screens while a new area loads).
++#pragma once
++
++#include <atomic>
++
++namespace Vulkan {
++inline std::atomic<bool> g_frame_incomplete{false};
++}
+diff --git a/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp b/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp
+index 8290ab2..8c0d737 100644
+--- a/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp
++++ b/src/video_core/renderer_vulkan/vk_pipeline_cache.cpp
+@@ -3,6 +3,7 @@
+ // Refer to the license.txt file included.
+ 
+ #include <algorithm>
++#include "video_core/renderer_vulkan/vk_frame_state.h"
+ #include <chrono>
+ #include <boost/container/static_vector.hpp>
+ 
+@@ -374,6 +375,8 @@ bool PipelineCache::BindPipeline(PipelineInfo& info, bool wait_built) {
+ 
+     GraphicsPipeline* const pipeline = curr_disk_cache->GetPipeline(info);
+     if (!pipeline->IsDone() && !pipeline->TryBuild(wait_built)) {
++        // Still building: this draw is skipped, so the frame lacks something.
++        g_frame_incomplete.store(true, std::memory_order_relaxed);
+         return false;
+     }
+     // Finish a pending build here rather than on the render thread, so a pipeline
+diff --git a/src/video_core/renderer_vulkan/vk_rasterizer.cpp b/src/video_core/renderer_vulkan/vk_rasterizer.cpp
+index 1e6538b..f47c02c 100644
+--- a/src/video_core/renderer_vulkan/vk_rasterizer.cpp
++++ b/src/video_core/renderer_vulkan/vk_rasterizer.cpp
+@@ -488,11 +488,11 @@ bool RasterizerVulkan::AccelerateDrawBatchInternal(bool is_indexed) {
+     }
+ 
+     // Upstream waits for small draws (UI quads) so they never flicker in. On Dozen a
+-    // pipeline takes the Xbox driver 0.4-3 s to build: waiting forever froze the game,
+-    // skipping made the world load in late. Wait a bounded time per second instead.
++    // pipeline takes the Xbox driver 0.4-3 s to build: waiting froze the game, so the
++    // draw is skipped and the frame is flagged incomplete; the libretro window then
++    // keeps showing the previous picture until the pipelines are ready.
+     const bool is_dozen = static_cast<u32>(instance.GetDriverID()) == 23u;
+-    pipeline_cache.bounded_wait = is_dozen;
+-    const bool wait_built = !async_shaders || is_dozen || regs.pipeline.num_vertices <= 6;
++    const bool wait_built = !async_shaders || (regs.pipeline.num_vertices <= 6 && !is_dozen);
+     if (!pipeline_cache.BindPipeline(pipeline_info, wait_built)) {
+         return true;
+     }
+-- 
+2.43.0
+
diff --git a/src/tests/video_core/vertex_cache.cpp b/src/tests/video_core/vertex_cache.cpp
index 505cfd2..486436e 100644
--- a/src/tests/video_core/vertex_cache.cpp
+++ b/src/tests/video_core/vertex_cache.cpp
@@ -35,6 +35,13 @@ struct Sim {
                         REQUIRE(page_refs[p] >= 0);
                     }
                 }} {
+        cache.SetHasher([this](std::uint32_t a, std::uint32_t n) {
+            std::uint64_t h = 1469598103934665603ull;
+            for (std::uint32_t i = 0; i < n; i++) {
+                h = (h ^ guest[a - kGuestBase + i]) * 1099511628211ull;
+            }
+            return h;
+        });
         for (auto& a : arena) a.assign(kSize, 0xEE);
         for (std::uint32_t i = 0; i < kGuestSize; i++) guest[i] = static_cast<std::uint8_t>(i * 7 + 3);
     }
@@ -55,6 +62,11 @@ struct Sim {
         std::memset(&guest[addr - kGuestBase], value, n);
     }
 
+    // A write the tracking never hears about (an HLE service, DMA, a GPU download).
+    void GuestWriteUntracked(std::uint32_t addr, std::uint8_t value, std::uint32_t n = 1) {
+        std::memset(&guest[addr - kGuestBase], value, n);
+    }
+
     // One draw of `stride`-byte vertices [vmin, vmax] from the buffer at `base`, through one or
     // two loaders (the second at base + 0x40000) to exercise pinning. Checks that what the GPU
     // would read equals guest memory.
@@ -252,3 +264,42 @@ TEST_CASE("VertexRegionCache: heavy reads untrack a buffer", "[video_core]") {
     REQUIRE(s.Tracked() == 0);
     REQUIRE(s.cache.IsVolatile((std::uint64_t{Sim::kGuestBase} << 8) | 16));
 }
+
+TEST_CASE("VertexRegionCache: a write that bypasses the tracking is still caught", "[video_core]") {
+    Sim s;
+    s.NextFrame();
+    s.Draw(Sim::kGuestBase, 16, 0, 400);
+    REQUIRE(s.uploads == 1);
+    s.GuestWriteUntracked(Sim::kGuestBase + 16 * 123 + 3, 0x5A, 4); // not reported to the cache
+    s.NextFrame();
+    s.Draw(Sim::kGuestBase, 16, 0, 400); // the memcmp inside checks the new bytes are drawn
+    REQUIRE(s.uploads == 2);
+    REQUIRE(s.cache.GetStats().stale == 1);
+    // Unchanged data is checked once per frame and keeps hitting.
+    for (int f = 0; f < 20; f++) {
+        s.NextFrame();
+        s.Draw(Sim::kGuestBase, 16, 0, 400);
+        s.Draw(Sim::kGuestBase, 16, 10, 20);
+    }
+    REQUIRE(s.uploads == 2);
+    REQUIRE(s.cache.GetStats().stale == 1);
+}
+
+TEST_CASE("VertexRegionCache: a stale block is also caught by random untracked writes",
+          "[video_core]") {
+    std::mt19937 rng(5);
+    Sim s;
+    for (int f = 0; f < 1500; f++) {
+        s.NextFrame();
+        for (int d = 0; d < 4; d++) {
+            const std::uint32_t buf = rng() % 12;
+            const std::uint32_t vmin = rng() % 200, vmax = vmin + rng() % 300;
+            s.Draw(Sim::kGuestBase + buf * 0x8000, 16, vmin, vmax, 1 + (rng() % 4 == 0));
+        }
+        if (rng() % 3 == 0) {
+            s.GuestWriteUntracked(Sim::kGuestBase + rng() % (Sim::kGuestSize - 64), rng() & 0xFF,
+                                  1 + rng() % 64);
+        }
+    }
+    REQUIRE(s.hits > 0);
+}
diff --git a/src/video_core/renderer_opengl/gl_rasterizer.cpp b/src/video_core/renderer_opengl/gl_rasterizer.cpp
index bcee2e8..e66b6a6 100644
--- a/src/video_core/renderer_opengl/gl_rasterizer.cpp
+++ b/src/video_core/renderer_opengl/gl_rasterizer.cpp
@@ -130,6 +130,14 @@ RasterizerOpenGL::RasterizerOpenGL(Memory::MemorySystem& memory, Pica::PicaCore&
             [this](u32 addr, u32 size, int delta) {
                 res_cache.TrackExternalRegion(addr, size, delta);
             });
+        vertex_cache->SetHasher([&memory](u32 addr, u32 size) -> u64 {
+            const MemoryRef ref = memory.GetPhysicalRef(addr);
+            const u8* p = ref.GetPtr();
+            if (!p) {
+                return 0;
+            }
+            return Common::ComputeHash64(p, std::min<std::size_t>(ref.GetSize(), size));
+        });
     }
     state.Apply();
 
@@ -526,10 +534,10 @@ void RasterizerOpenGL::SetupVertexArray(u8* array_ptr, GLintptr buffer_offset,
         LOG_INFO(Render_OpenGL,
                  "Vertex data: {} MiB drawn in {} draws: {} MiB from the cache, {} MiB copied "
                  "into it, {} MiB per-draw uploads. Cache: {} blocks, {} MiB watched, {} dropped "
-                 "by game writes, {} buffer turns, {} volatile buffers",
+                 "by game writes, {} found stale by checksum ({} unchecked), {} buffer turns, {} volatile buffers",
                  st_bytes >> 20, st_draws, st_hit >> 20, st_copied >> 20, st_streamed >> 20,
-                 cs.entries, cs.tracked_bytes >> 20, cs.invalidations, cs.recycles,
-                 vertex_cache->VolatileKeys());
+                 cs.entries, cs.tracked_bytes >> 20, cs.invalidations, cs.stale, cs.unchecked,
+                 cs.recycles, vertex_cache->VolatileKeys());
         st_bytes = st_hit = st_copied = st_streamed = st_draws = 0;
         st_start = now;
     }
diff --git a/src/video_core/renderer_vulkan/vk_rasterizer.cpp b/src/video_core/renderer_vulkan/vk_rasterizer.cpp
index ce2c57e..327a339 100644
--- a/src/video_core/renderer_vulkan/vk_rasterizer.cpp
+++ b/src/video_core/renderer_vulkan/vk_rasterizer.cpp
@@ -96,6 +96,14 @@ RasterizerVulkan::RasterizerVulkan(Memory::MemorySystem& memory, Pica::PicaCore&
             [this](u32 addr, u32 size, int delta) {
                 res_cache.TrackExternalRegion(addr, size, delta);
             });
+        vertex_cache->SetHasher([&memory](u32 addr, u32 size) -> u64 {
+            const MemoryRef ref = memory.GetPhysicalRef(addr);
+            const u8* p = ref.GetPtr();
+            if (!p) {
+                return 0;
+            }
+            return Common::ComputeHash64(p, std::min<std::size_t>(ref.GetSize(), size));
+        });
     }
 
     // Query uniform buffer alignment.
@@ -613,10 +621,12 @@ void RasterizerVulkan::SetupVertexArray() {
                      "Vertex data: {} MiB drawn in {} draws: {} MiB from the cache, {} MiB "
                      "copied into it, {} MiB per-draw uploads ({} MiB of them from often-rewritten "
                      "buffers); largest {} KiB. Cache: {} blocks, {} MiB of game memory watched, "
-                     "{} dropped by game writes, {} arena turns ({} waited), {} volatile buffers",
+                     "{} dropped by game writes, {} found stale by checksum ({} unchecked), {} arena turns "
+                     "({} waited), {} volatile buffers",
                      st_bytes >> 20, st_draws, st_cache_hit_bytes >> 20, st_uploaded >> 20,
                      st_streamed >> 20, st_volatile >> 20, st_max >> 10, cs.entries,
-                     cs.tracked_bytes >> 20, cs.invalidations, cs.recycles, st_recycle_waits,
+                     cs.tracked_bytes >> 20, cs.invalidations, cs.stale, cs.unchecked, cs.recycles,
+                     st_recycle_waits,
                      vertex_cache->VolatileKeys());
             st_bytes = st_draws = st_max = st_uploaded = 0;
             st_cache_hit_bytes = st_streamed = st_volatile = st_recycle_waits = 0;
diff --git a/src/video_core/vertex_region_cache.h b/src/video_core/vertex_region_cache.h
index 89c1181..e1b8468 100644
--- a/src/video_core/vertex_region_cache.h
+++ b/src/video_core/vertex_region_cache.h
@@ -44,6 +44,8 @@ public:
 
     /// track(addr, size, +1 / -1): start / stop watching guest writes to these bytes.
     using TrackFn = std::function<void(std::uint32_t addr, std::uint32_t size, int delta)>;
+    /// hash(addr, size): a hash of the guest bytes as they are right now.
+    using HashFn = std::function<std::uint64_t(std::uint32_t addr, std::uint32_t size)>;
 
     struct Slot {
         std::uint32_t arena{NONE};
@@ -61,7 +63,7 @@ public:
 
     struct Stats {
         std::uint64_t hits{0}, misses{0}, invalidations{0}, volatile_skips{0}, recycles{0},
-            pinned_fails{0}, entries{0}, tracked_bytes{0};
+            pinned_fails{0}, entries{0}, tracked_bytes{0}, stale{0}, unchecked{0};
     };
 
     VertexRegionCache(std::uint32_t arena_count, std::uint32_t arena_size, TrackFn track_fn)
@@ -79,8 +81,20 @@ public:
     }
 
     void SetFrame(std::uint64_t f) {
+        if (f != frame) {
+            validate_budget = VALIDATE_BYTES_PER_FRAME;
+        }
         frame = f;
     }
+
+    /// Write tracking only sees writes that go through the emulated memory interface; HLE
+    /// services, DMA and GPU downloads can write guest memory directly. With a hash function set,
+    /// each block is checked against the guest bytes it was copied from the first time it is used
+    /// in a frame (the whole cache is about a megabyte, so this is cheap), and dropped when they
+    /// changed behind the tracking's back.
+    void SetHasher(HashFn fn) {
+        hasher = std::move(fn);
+    }
     std::uint64_t Frame() const {
         return frame;
     }
@@ -95,14 +109,32 @@ public:
                 std::uint32_t& offset) {
         const auto it = by_key.find(key);
         if (it != by_key.end()) {
-            for (const std::uint32_t id : it->second) {
-                const Entry& e = entries[id];
-                if (e.live && e.first <= vmin && vmax <= e.last) {
-                    arena = e.arena;
-                    offset = e.offset + (vmin - e.first) * e.stride;
-                    ++stats.hits;
-                    return true;
+            const std::vector<std::uint32_t> ids = it->second; // Kill() edits the list
+            for (const std::uint32_t id : ids) {
+                Entry& e = entries[id];
+                if (!(e.live && e.first <= vmin && vmax <= e.last)) {
+                    continue;
                 }
+                if (hasher && e.src_end > e.src_begin && e.checked != frame) {
+                    const std::uint32_t bytes = e.src_end - e.src_begin;
+                    if (bytes <= validate_budget) {
+                        validate_budget -= bytes;
+                        if (hasher(e.src_begin, bytes) != e.sum) {
+                            // Changed without the tracking noticing: drop it and copy again.
+                            Strike(e.key, frame - e.created <= 2);
+                            Kill(id);
+                            ++stats.stale;
+                            continue;
+                        }
+                        e.checked = frame;
+                    } else {
+                        ++stats.unchecked;
+                    }
+                }
+                arena = e.arena;
+                offset = e.offset + (vmin - e.first) * e.stride;
+                ++stats.hits;
+                return true;
             }
         }
         ++stats.misses;
@@ -192,6 +224,10 @@ public:
         e.arena = slot.arena;
         e.offset = slot.offset;
         e.created = frame;
+        if (hasher && src_size) {
+            e.sum = hasher(src_begin, src_size);
+            e.checked = frame;
+        }
         e.live = true;
         arena_ids[slot.arena].push_back(id);
         by_key[key].push_back(id);
@@ -301,6 +337,8 @@ public:
     std::uint32_t strikes_to_volatile = 3;
     std::uint64_t volatile_frames = 600;
     static constexpr std::uint32_t READS_PER_FRAME = 4096;
+    /// Bytes of blocks re-checked per frame; past it blocks are trusted until the next frame.
+    static constexpr std::uint32_t VALIDATE_BYTES_PER_FRAME = 8u << 20;
 
 private:
     struct Entry {
@@ -310,6 +348,8 @@ private:
         std::uint32_t arena{}, offset{};
         std::uint64_t created{};
         std::uint64_t read_frame{};
+        std::uint64_t sum{};
+        std::uint64_t checked{~0ull};
         std::uint32_t reads{};
         bool live{};
     };
@@ -402,6 +442,8 @@ private:
     std::uint32_t count;
     std::uint32_t size;
     TrackFn track;
+    HashFn hasher;
+    std::uint32_t validate_budget{VALIDATE_BYTES_PER_FRAME};
     std::uint32_t active{0};
     std::uint32_t used{0};
     std::uint64_t frame{1};
-- 
