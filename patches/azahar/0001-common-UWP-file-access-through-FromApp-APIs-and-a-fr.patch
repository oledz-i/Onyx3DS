+#ifdef CITRA_UWP
+// UWP: route the Win32 file calls below through the *FromApp variants so that
+// folders the user granted (USB drives, broadFileSystemAccess) are reachable.
+namespace {
+int UwpWStat64(const wchar_t* path, struct _stat64* out) {
+    WIN32_FILE_ATTRIBUTE_DATA data{};
+    if (!GetFileAttributesExFromAppW(path, GetFileExInfoStandard, &data)) {
+        return -1;
+    }
+    *out = {};
+    const bool is_dir = (data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0;
+    out->st_mode = static_cast<unsigned short>(is_dir ? _S_IFDIR : _S_IFREG);
+    out->st_size = (static_cast<__int64>(data.nFileSizeHigh) << 32) | data.nFileSizeLow;
+    return 0;
+}
+
+HANDLE UwpCreateFileW(LPCWSTR name, DWORD access, DWORD share, LPSECURITY_ATTRIBUTES, DWORD creation,
+                      DWORD attributes, HANDLE) {
+    CREATEFILE2_EXTENDED_PARAMETERS params{};
+    params.dwSize = sizeof(params);
+    params.dwFileAttributes = attributes;
+    return CreateFile2FromAppW(name, access, share, creation, &params);
+}
+
+BOOL UwpMoveFileExW(LPCWSTR from, LPCWSTR to, DWORD flags) {
+    if ((flags & MOVEFILE_REPLACE_EXISTING) != 0) {
+        DeleteFileFromAppW(to); // MoveFileFromAppW never overwrites
+    }
+    return MoveFileFromAppW(from, to);
+}
+
+HANDLE UwpFindFirstFileW(LPCWSTR pattern, LPWIN32_FIND_DATAW data) {
+    return FindFirstFileExFromAppW(pattern, FindExInfoBasic, data, FindExSearchNameMatch, nullptr,
+                                   0);
+}
+} // namespace
+
+#define _wstat64 UwpWStat64
+#define CreateFileW UwpCreateFileW
+#define MoveFileExW UwpMoveFileExW
+#define FindFirstFileW UwpFindFirstFileW
+#define CreateDirectoryW CreateDirectoryFromAppW
+#define RemoveDirectoryW RemoveDirectoryFromAppW
+#define DeleteFileW DeleteFileFromAppW
+#define CopyFileW CopyFileFromAppW
+#endif // CITRA_UWP
+
 #ifndef S_ISDIR
 #define S_ISDIR(m) (((m) & S_IFMT) == S_IFDIR)
 #endif
