+//
+// Detects Universal Windows Platform builds (Xbox Dev Mode). UWP apps run in
+// an app container: desktop-only Win32 calls are missing at link time, and
+// files outside the package (for example a USB drive) can only be reached
+// through the *FromApp variants of the file APIs.
+
+#pragma once
+
+#if defined(_WIN32)
+#include <winapifamily.h>
+#if WINAPI_FAMILY_PARTITION(WINAPI_PARTITION_APP) &&                                              \
+    !WINAPI_FAMILY_PARTITION(WINAPI_PARTITION_DESKTOP)
+#define CITRA_UWP 1
+#endif
+#endif
