+/**
+ * Optional hook that rewrites every path before it reaches the OS. Frontends
+ * use it to point fixed parts of the user directory (texture packs, mods,
+ * cheats) at folders elsewhere, e.g. on removable storage. Passing nullptr
+ * restores the identity mapping. The translator must be thread-safe.
+ */
+using PathTranslator = std::string (*)(const std::string& path);
+void SetPathTranslator(PathTranslator translator);
+[[nodiscard]] std::string TranslatePath(const std::string& path);
