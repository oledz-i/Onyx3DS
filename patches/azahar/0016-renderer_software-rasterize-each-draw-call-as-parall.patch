@@ -4,7 +4,11 @@
 
 #pragma once
 
+#include <atomic>
+#include <functional>
+#include <memory>
 #include <span>
+#include <vector>
 #include "common/thread_worker.h"
 #include "video_core/pica/regs_texturing.h"
 #include "video_core/rasterizer_interface.h"
@@ -26,11 +30,19 @@ public:
 
     void AddTriangle(const Pica::OutputVertex& v0, const Pica::OutputVertex& v1,
                      const Pica::OutputVertex& v2) override;
-    void DrawTriangles() override {}
-    void FlushAll() override {}
-    void FlushRegion(PAddr addr, u32 size) override {}
-    void InvalidateRegion(PAddr addr, u32 size) override {}
-    void FlushAndInvalidateRegion(PAddr addr, u32 size) override {}
+    void DrawTriangles() override;
+    void FlushAll() override {
+        DrawTriangles();
+    }
+    void FlushRegion(PAddr addr, u32 size) override {
+        DrawTriangles();
+    }
+    void InvalidateRegion(PAddr addr, u32 size) override {
+        DrawTriangles();
+    }
+    void FlushAndInvalidateRegion(PAddr addr, u32 size) override {
+        DrawTriangles();
+    }
     void ClearAll(bool flush) override {}
 
 private:
@@ -72,6 +84,26 @@ private:
     std::size_t num_sw_threads;
     Common::ThreadWorker sw_workers;
     Framebuffer fb;
+
+    /// A triangle waiting for DrawTriangles(): draws one scanline of itself per call.
+    struct PendingTriangle {
+        std::function<void(u16)> scanline;
+        u32 first_row; ///< First covered pixel row
+        u32 rows;
+    };
+    /// All triangles of one draw call, split into screen bands drawn by several threads.
+    struct Batch {
+        std::vector<PendingTriangle> jobs;
+        u32 lo = 0;
+        u32 hi = 0;
+        u32 band_rows = 1;
+        u32 num_bands = 0;
+        std::atomic<u32> next{0};
+        std::atomic<u32> done{0};
+        void Run();
+    };
+    std::vector<PendingTriangle> pending;
+    u64 pending_area = 0;
 };
 
 } // namespace SwRenderer
