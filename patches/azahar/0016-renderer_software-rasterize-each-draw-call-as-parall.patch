 RasterizerSoftware::RasterizerSoftware(Memory::MemorySystem& memory_, Pica::PicaCore& pica_)
@@ -299,8 +309,6 @@ void RasterizerSoftware::ProcessTriangle(const Vertex& v0, const Vertex& v1, con
     const auto textures = regs.texturing.GetTextures();
     const auto tev_stages = regs.texturing.GetTevStages();
 
-    fb.Bind();
-
     // Enter rasterization loop, starting at the center of the topleft bounding box corner.
     // TODO: Not sure if looping through x first might be faster
     // One scanline of the triangle. (Was queued as its own job per scanline;
@@ -342,7 +350,7 @@ void RasterizerSoftware::ProcessTriangle(const Vertex& v0, const Vertex& v1, con
     const bool need_uv1 = textures[1].enabled || (textures[2].enabled && use_coord1_for_2);
     const bool need_uv2 = textures[2].enabled && !use_coord1_for_2;
 
-    const auto process_scanline = [&](u16 y) {
+    auto process_scanline = [=, this](u16 y) {
             // Edge function values at the first pixel of the row, and their step per pixel.
             std::array<s64, 3> base;
             std::array<s64, 3> step;
@@ -535,38 +543,92 @@ void RasterizerSoftware::ProcessTriangle(const Vertex& v0, const Vertex& v1, con
             }
     };
 
-    // Queueing every scanline as a separate job and waiting after each triangle
-    // spends more time waking and joining workers than drawing for the many
-    // small triangles 2D games use. Draw small triangles on this thread, and
-    // split large ones into one contiguous band of scanlines per worker.
+    // Rasterization is deferred to DrawTriangles(): the whole draw call's triangles are
+    // queued here, then each screen band is drawn by one thread with every triangle in
+    // submission order (per-pixel order is preserved, bands never overlap).
     const u16 first_y = static_cast<u16>(min_y + 8);
     if (first_y >= max_y) {
         return;
     }
     const u32 rows = (static_cast<u32>(max_y) - first_y + 0xF) >> 4;
     const u32 cols = max_x > min_x ? (static_cast<u32>(max_x) - min_x) >> 4 : 0;
-    constexpr u32 kInlinePixels = 8 * 1024;
-    if (rows < 16 || rows * cols < kInlinePixels || num_sw_threads < 2) {
-        for (u32 r = 0; r < rows; ++r) {
-            process_scanline(static_cast<u16>(first_y + r * 0x10));
+    pending_area += static_cast<u64>(rows) * cols;
+    pending.push_back(PendingTriangle{std::move(process_scanline), static_cast<u32>(first_y >> 4),
+                                      rows});
+}
+
+void RasterizerSoftware::DrawTriangles() {
+    if (pending.empty()) {
+        return;
+    }
+    fb.Bind();
+    constexpr u64 kInlinePixels = 6 * 1024;
+    if (num_sw_threads < 2 || pending_area < kInlinePixels) {
+        for (const auto& job : pending) {
+            for (u32 r = 0; r < job.rows; ++r) {
+                job.scanline(static_cast<u16>(((job.first_row + r) << 4) + 8));
+            }
         }
+        pending.clear();
+        pending_area = 0;
         return;
     }
-    const u32 bands = std::min<u32>(static_cast<u32>(num_sw_threads), rows / 4);
-    const u32 per_band = (rows + bands - 1) / bands;
-    for (u32 b = 0; b < bands; ++b) {
-        const u32 r0 = b * per_band;
-        const u32 r1 = std::min(rows, r0 + per_band);
-        if (r0 >= r1) {
-            break;
+
+    auto batch = std::make_shared<Batch>();
+    batch->jobs = std::move(pending);
+    pending.clear();
+    pending_area = 0;
+    u32 lo = ~0u;
+    u32 hi = 0;
+    for (const auto& job : batch->jobs) {
+        lo = std::min(lo, job.first_row);
+        hi = std::max(hi, job.first_row + job.rows);
+    }
+    const u32 range = hi - lo;
+    const u32 want = static_cast<u32>(num_sw_threads) * 2;
+    batch->lo = lo;
+    batch->hi = hi;
+    batch->band_rows = std::max<u32>(4, (range + want - 1) / want);
+    batch->num_bands = (range + batch->band_rows - 1) / batch->band_rows;
+
+    // Workers only touch this batch through the shared pointer, so a worker that wakes up
+    // after the batch is finished finds nothing to do and never touches freed state.
+    const u32 helpers = std::min<u32>(static_cast<u32>(num_sw_threads), batch->num_bands) - 1;
+    for (u32 i = 0; i < helpers; ++i) {
+        sw_workers.QueueWork([batch] { batch->Run(); });
+    }
+    batch->Run();
+    // The main thread joins in above; this only waits for bands other threads still draw.
+    u32 spins = 0;
+    while (batch->done.load(std::memory_order_acquire) < batch->num_bands) {
+        if (++spins < 4000) {
+            YieldCpu();
+        } else {
+            std::this_thread::yield();
         }
-        sw_workers.QueueWork([&process_scanline, first_y, r0, r1] {
+    }
+}
+
+void RasterizerSoftware::Batch::Run() {
+    for (;;) {
+        const u32 b = next.fetch_add(1, std::memory_order_relaxed);
+        if (b >= num_bands) {
+            return;
+        }
+        const u32 y0 = lo + b * band_rows;
+        const u32 y1 = std::min(hi, y0 + band_rows);
+        for (const auto& job : jobs) {
+            if (job.first_row >= y1 || job.first_row + job.rows <= y0) {
+                continue;
+            }
+            const u32 r0 = y0 > job.first_row ? y0 - job.first_row : 0;
+            const u32 r1 = std::min(job.rows, y1 - job.first_row);
             for (u32 r = r0; r < r1; ++r) {
-                process_scanline(static_cast<u16>(first_y + r * 0x10));
+                job.scanline(static_cast<u16>(((job.first_row + r) << 4) + 8));
             }
-        });
+        }
+        done.fetch_add(1, std::memory_order_release);
     }
-    sw_workers.WaitForRequests();
 }
 
