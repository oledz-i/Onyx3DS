 .../renderer_software/sw_rasterizer.cpp       | 106 ++++++++++++++----
 .../renderer_software/sw_rasterizer.h         |  42 ++++++-
 3 files changed, 143 insertions(+), 29 deletions(-)

diff --git a/src/video_core/renderer_software/sw_blitter.cpp b/src/video_core/renderer_software/sw_blitter.cpp
