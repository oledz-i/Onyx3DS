From e295b824aeaf2f7d3c10c26d988d9a0509851507 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 4 Oct 2026 11:13:21 -0400
Subject: [PATCH] renderer_software: batch rasterizer work; table-driven
 libretro blit

Software rendering on Xbox ran at 2-12 FPS, with shader JIT making no
difference, so vertex processing was not the bottleneck.

- RasterizerSoftware::ProcessTriangle queued every scanline of every
  triangle as its own worker job and joined all workers after each
  triangle. For the many small triangles 2D games draw, thread wake-ups
  and joins cost more than the drawing. Small triangles (fewer than 16
  rows or 8K pixels) are now drawn on the calling thread; larger ones are
  split into one contiguous band of scanlines per worker. Each scanline is
  processed exactly as before.
- The libretro software blit did two integer divisions and a bounds check
  per output pixel. Source columns are now computed once per screen and
  repeated rows of an integer upscale are copied. Output is byte-identical
  (checked against the old loop for every layout) and about 4x faster.
---
 .../emu_window/libretro_window.cpp            | 44 +++++++++++++------
 .../renderer_software/sw_rasterizer.cpp       | 39 ++++++++++++++--
 2 files changed, 66 insertions(+), 17 deletions(-)

diff --git a/src/citra_libretro/emu_window/libretro_window.cpp b/src/citra_libretro/emu_window/libretro_window.cpp
index f8cfb2c..2e864b7 100644
--- a/src/citra_libretro/emu_window/libretro_window.cpp
+++ b/src/citra_libretro/emu_window/libretro_window.cpp
@@ -7,6 +7,8 @@
 #endif
 #include <libretro.h>
 
+#include <cstring>
+#include <vector>
 #include "audio_core/audio_types.h"
 #include "citra_libretro/citra_libretro.h"
 #include "citra_libretro/core_settings.h"
@@ -131,25 +133,41 @@ void EmuWindow_LibRetro::SwapBuffers() {
             const u32 native_w = info.height;
             const u32 native_h = info.width;
 
+            // Source column for every output column, computed once per screen
+            // instead of a division per pixel. Same mapping as before.
+            thread_local std::vector<u32> col_src;
+            col_src.resize(rect_w);
+            for (u32 ox = 0; ox < rect_w; ox++) {
+                col_src[ox] = ox * native_w / rect_w;
+            }
+            const size_t src_size = info.pixels.size();
+            u32 prev_dy = ~0u;
+            u8* prev_row = nullptr;
             for (u32 oy = 0; oy < rect_h; oy++) {
+                const u32 dy = oy * native_h / rect_h;
+                u8* dst_row = data + static_cast<size_t>(rect.top + oy) * pitch +
+                              static_cast<size_t>(rect.left) * 4;
+                if (dy == prev_dy && prev_row) {
+                    // Integer upscaling repeats source rows: copy the row just built.
+                    std::memcpy(dst_row, prev_row, static_cast<size_t>(rect_w) * 4);
+                    continue;
+                }
+                const size_t row_off = static_cast<size_t>(dy) * info.height * 4;
                 for (u32 ox = 0; ox < rect_w; ox++) {
-                    const u32 dx = ox * native_w / rect_w;
-                    const u32 dy = oy * native_h / rect_h;
-
-                    const u32 src_off = (dy * info.height + dx) * 4;
-                    if (src_off + 3 >= info.pixels.size())
+                    // Same addressing as the original: (dy * info.height + dx) * 4.
+                    const size_t src_off = row_off + static_cast<size_t>(col_src[ox]) * 4;
+                    if (src_off + 3 >= src_size)
                         continue;
-
                     const u8* src = info.pixels.data() + src_off;
-                    const size_t dst_off = static_cast<size_t>(rect.top + oy) * pitch +
-                                           static_cast<size_t>(rect.left + ox) * 4;
-
                     // RGBA -> XRGB8888 (little-endian: B, G, R, 0)
-                    data[dst_off + 0] = src[2];
-                    data[dst_off + 1] = src[1];
-                    data[dst_off + 2] = src[0];
-                    data[dst_off + 3] = 0;
+                    u8* d = dst_row + static_cast<size_t>(ox) * 4;
+                    d[0] = src[2];
+                    d[1] = src[1];
+                    d[2] = src[0];
+                    d[3] = 0;
                 }
+                prev_dy = dy;
+                prev_row = dst_row;
             }
         };
 
diff --git a/src/video_core/renderer_software/sw_rasterizer.cpp b/src/video_core/renderer_software/sw_rasterizer.cpp
index a64c951..1f87717 100644
--- a/src/video_core/renderer_software/sw_rasterizer.cpp
+++ b/src/video_core/renderer_software/sw_rasterizer.cpp
@@ -303,8 +303,9 @@ void RasterizerSoftware::ProcessTriangle(const Vertex& v0, const Vertex& v1, con
 
     // Enter rasterization loop, starting at the center of the topleft bounding box corner.
     // TODO: Not sure if looping through x first might be faster
-    for (u16 y = min_y + 8; y < max_y; y += 0x10) {
-        const auto process_scanline = [&, y] {
+    // One scanline of the triangle. (Was queued as its own job per scanline;
+    // see the dispatch below.)
+    const auto process_scanline = [&](u16 y) {
             for (u16 x = min_x + 8; x < max_x; x += 0x10) {
                 // Do not process the pixel if it's inside the scissor box and the scissor mode is
                 // set to Exclude.
@@ -466,8 +467,38 @@ void RasterizerSoftware::ProcessTriangle(const Vertex& v0, const Vertex& v1, con
                     fb.DrawPixel(x >> 4, y >> 4, result);
                 }
             }
-        };
-        sw_workers.QueueWork(std::move(process_scanline));
+    };
+
+    // Queueing every scanline as a separate job and waiting after each triangle
+    // spends more time waking and joining workers than drawing for the many
+    // small triangles 2D games use. Draw small triangles on this thread, and
+    // split large ones into one contiguous band of scanlines per worker.
+    const u16 first_y = static_cast<u16>(min_y + 8);
+    if (first_y >= max_y) {
+        return;
+    }
+    const u32 rows = (static_cast<u32>(max_y) - first_y + 0xF) >> 4;
+    const u32 cols = max_x > min_x ? (static_cast<u32>(max_x) - min_x) >> 4 : 0;
+    constexpr u32 kInlinePixels = 8 * 1024;
+    if (rows < 16 || rows * cols < kInlinePixels || num_sw_threads < 2) {
+        for (u32 r = 0; r < rows; ++r) {
+            process_scanline(static_cast<u16>(first_y + r * 0x10));
+        }
+        return;
+    }
+    const u32 bands = std::min<u32>(static_cast<u32>(num_sw_threads), rows / 4);
+    const u32 per_band = (rows + bands - 1) / bands;
+    for (u32 b = 0; b < bands; ++b) {
+        const u32 r0 = b * per_band;
+        const u32 r1 = std::min(rows, r0 + per_band);
+        if (r0 >= r1) {
+            break;
+        }
+        sw_workers.QueueWork([&process_scanline, first_y, r0, r1] {
+            for (u32 r = r0; r < r1; ++r) {
+                process_scanline(static_cast<u16>(first_y + r * 0x10));
+            }
+        });
     }
     sw_workers.WaitForRequests();
 }
-- 
