From 23ee2374ee062f67851f95ed86d54c97f89f1600 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 4 Oct 2026 01:23:12 +0000
Subject: [PATCH] httplib: UWP file mapping through *FromApp APIs

---
 externals/cryptopp          |  2 +-
 externals/httplib/httplib.h | 36 +++++++++++++++++++++++++++++++++++-
 2 files changed, 36 insertions(+), 2 deletions(-)

diff --git a/externals/cryptopp b/externals/cryptopp
index 8d92d7884..affd091dd 160000
--- a/externals/cryptopp
+++ b/externals/cryptopp
@@ -1 +1 @@
-Subproject commit 8d92d788421483a43e09acf1cd4a2861cb2b8cab
+Subproject commit affd091dd411e8756422fdc31479c537a3a54ea9
diff --git a/externals/httplib/httplib.h b/externals/httplib/httplib.h
index c49e50e69..d777fc397 100644
--- a/externals/httplib/httplib.h
+++ b/externals/httplib/httplib.h
@@ -154,6 +154,13 @@ using ssize_t = long;
 
 #include <io.h>
 #include <winsock2.h>
+#include <winapifamily.h>
+#if WINAPI_FAMILY_PARTITION(WINAPI_PARTITION_APP) &&                           \
+    !WINAPI_FAMILY_PARTITION(WINAPI_PARTITION_DESKTOP)
+#define CPPHTTPLIB_UWP 1
+#include <fileapifromapp.h>
+#include <memoryapi.h>
+#endif
 #include <ws2tcpip.h>
 
 #ifndef WSA_FLAG_NO_HANDLE_INHERIT
@@ -2577,7 +2584,34 @@ inline mmap::~mmap() { close(); }
 inline bool mmap::open(const char *path) {
   close();
 
-#if defined(_WIN32)
+#if defined(CPPHTTPLIB_UWP)
+  // Universal Windows Platform: only the *FromApp / *2 file APIs exist.
+  {
+    const int n = ::MultiByteToWideChar(CP_UTF8, 0, path, -1, NULL, 0);
+    std::wstring wpath(n > 0 ? static_cast<size_t>(n) : 1, L'\0');
+    if (n > 0) { ::MultiByteToWideChar(CP_UTF8, 0, path, -1, &wpath[0], n); }
+    CREATEFILE2_EXTENDED_PARAMETERS params = {};
+    params.dwSize = sizeof(params);
+    params.dwFileAttributes = FILE_ATTRIBUTE_NORMAL;
+    hFile_ = ::CreateFile2FromAppW(wpath.c_str(), GENERIC_READ, FILE_SHARE_READ,
+                                   OPEN_EXISTING, &params);
+  }
+
+  if (hFile_ == INVALID_HANDLE_VALUE) { return false; }
+
+  LARGE_INTEGER file_size = {};
+  ::GetFileSizeEx(hFile_, &file_size);
+  size_ = static_cast<size_t>(file_size.QuadPart);
+
+  hMapping_ = ::CreateFileMappingFromApp(hFile_, NULL, PAGE_READONLY, 0, NULL);
+
+  if (hMapping_ == NULL) {
+    close();
+    return false;
+  }
+
+  addr_ = ::MapViewOfFileFromApp(hMapping_, FILE_MAP_READ, 0, 0);
+#elif defined(_WIN32)
   hFile_ = ::CreateFileA(path, GENERIC_READ, FILE_SHARE_READ, NULL,
                          OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
 
-- 
2.43.0

