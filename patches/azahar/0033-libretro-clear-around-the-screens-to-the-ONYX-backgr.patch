From bf9dc5d5b3dc7ef6a5f17cc6151c36d7bf8db4ff Mon Sep 17 00:00:00 2001
From: Jayden Holley <jaydenlholley@gmail.com>
Date: Mon, 5 Oct 2026 19:32:54 -0400
Subject: [PATCH] libretro: clear around the screens to the ONYX background on
 Dozen

Matches the app and lets the frontend's readback check tell a frame that was
cleared but had nothing drawn apart from one that was never rendered.
---
 src/citra_libretro/libretro_vk.cpp | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/src/citra_libretro/libretro_vk.cpp b/src/citra_libretro/libretro_vk.cpp
index d44f12c..a45c917 100644
--- a/src/citra_libretro/libretro_vk.cpp
+++ b/src/citra_libretro/libretro_vk.cpp
@@ -353,6 +353,12 @@ LibRetroVKInstance::LibRetroVKInstance(Frontend::EmuWindow& window,
         // stall a frame for hundreds of ms; compile in the background instead.
         Settings::values.async_shader_compilation.SetValue(true);
         LOG_INFO(Render_Vulkan, "Dozen: asynchronous shader compilation on");
+        // Clear around the screens to the ONYX background instead of pure black. It
+        // matches the app, and the frontend's readback check can then tell a frame
+        // that was cleared but had nothing drawn apart from one never rendered at all.
+        Settings::values.bg_red.SetValue(16.f / 255.f);
+        Settings::values.bg_green.SetValue(18.f / 255.f);
+        Settings::values.bg_blue.SetValue(24.f / 255.f);
     }
 
     // Initialize subsystems
-- 
2.43.0

