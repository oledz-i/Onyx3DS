From 0950cb2c7c674f7a8198ef8e7ed8aac1894e9794 Mon Sep 17 00:00:00 2001
From: ONYX <onyx@users.noreply.github.com>
Date: Mon, 5 Oct 2026 06:36:51 -0400
Subject: [PATCH 26/27] renderer_software: decode the TEV stages once per
 triangle

The texture combiner was ~28% of the emulation thread in NSMB2: every pixel
re-read six stages of register bit fields, switched over sources and walked
trailing pass-through stages. Decode the stages into plain bytes per
triangle, read sources from a small table, skip multiplies by one and stop
after the last stage that changes the colour. Same results.
---
 .../renderer_software/sw_rasterizer.cpp       | 153 +++++++++++++++++-
 .../renderer_software/sw_rasterizer.h         |  33 ++++
 2 files changed, 183 insertions(+), 3 deletions(-)

diff --git a/src/video_core/renderer_software/sw_rasterizer.cpp b/src/video_core/renderer_software/sw_rasterizer.cpp
index 8b2b8fd..2917e7a 100644
--- a/src/video_core/renderer_software/sw_rasterizer.cpp
+++ b/src/video_core/renderer_software/sw_rasterizer.cpp
@@ -408,6 +408,7 @@ void RasterizerSoftware::ProcessTriangle(const Vertex& v0, const Vertex& v1, con
         }
     }
     const auto tev_stages = regs.texturing.GetTevStages();
+    const TevProgram tev = CompileTev(tev_stages);
 
     // Enter rasterization loop, starting at the center of the topleft bounding box corner.
     // TODO: Not sure if looping through x first might be faster
@@ -620,9 +621,8 @@ void RasterizerSoftware::ProcessTriangle(const Vertex& v0, const Vertex& v1, con
                 }
 
                 // Write the TEV stages.
-                auto combiner_output =
-                    WriteTevConfig(texture_color, tev_stages, primary_color, primary_fragment_color,
