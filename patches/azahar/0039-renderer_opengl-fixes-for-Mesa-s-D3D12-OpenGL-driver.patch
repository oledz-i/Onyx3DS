     if (precompiled_file.WriteObject(static_cast<u32>(PrecompiledEntryKind::Dump)) != 1 ||
         precompiled_file.WriteObject(unique_identifier) != 1 ||
-        precompiled_file.WriteObject(static_cast<u32>(binary_format)) != 1 ||
