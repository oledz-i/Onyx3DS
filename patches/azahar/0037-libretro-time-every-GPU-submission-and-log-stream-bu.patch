-        wait_queue.emplace(fence, signal_value);
+        wait_queue.push(PendingWork{fence, signal_value, timing_slot});
         wait_cv.notify_one();
     }
 }
@@ -869,6 +980,7 @@ void MasterSemaphoreLibRetro::WaitThread(std::stop_token token) {
     while (!token.stop_requested()) {
         vk::Fence fence;
         u64 signal_value;
+        u32 timing_slot;
 
         // Wait for work
         {
@@ -877,7 +989,10 @@ void MasterSemaphoreLibRetro::WaitThread(std::stop_token token) {
             if (token.stop_requested()) {
