+void MasterSemaphoreLibRetro::InitGpuTiming() {
+    try {
+        const vk::Device device{instance.GetDevice()};
+        const auto props = instance.GetPhysicalDevice().getProperties();
+        const auto families = instance.GetPhysicalDevice().getQueueFamilyProperties();
+        const u32 family = instance.GetGraphicsQueueFamilyIndex();
+        const u32 valid_bits = family < families.size() ? families[family].timestampValidBits : 0;
+        if (valid_bits == 0 || props.limits.timestampPeriod <= 0.f) {
+            LOG_INFO(Render_Vulkan, "GPU timing: timestamps not supported");
+            return;
+        }
+        timing_period_ns = props.limits.timestampPeriod;
+        timing_mask = valid_bits >= 64 ? ~0ULL : ((1ULL << valid_bits) - 1);
+        timing_pool = device.createQueryPool({
+            .queryType = vk::QueryType::eTimestamp,
+            .queryCount = TIMING_SLOTS * 2,
+        });
+        timing_cmd_pool = device.createCommandPool({.queueFamilyIndex = family});
+        timing_start = device.allocateCommandBuffers({
+            .commandPool = timing_cmd_pool,
+            .level = vk::CommandBufferLevel::ePrimary,
+            .commandBufferCount = TIMING_SLOTS,
+        });
+        timing_end = device.allocateCommandBuffers({
+            .commandPool = timing_cmd_pool,
+            .level = vk::CommandBufferLevel::ePrimary,
+            .commandBufferCount = TIMING_SLOTS,
+        });
+        timing_submit_time.resize(TIMING_SLOTS);
+        for (u32 i = 0; i < TIMING_SLOTS; i++) {
+            timing_start[i].begin(vk::CommandBufferBeginInfo{});
+            timing_start[i].resetQueryPool(timing_pool, i * 2, 2);
+            timing_start[i].writeTimestamp(vk::PipelineStageFlagBits::eTopOfPipe, timing_pool, i * 2);
+            timing_start[i].end();
+            timing_end[i].begin(vk::CommandBufferBeginInfo{});
+            timing_end[i].writeTimestamp(vk::PipelineStageFlagBits::eBottomOfPipe, timing_pool,
+                                         i * 2 + 1);
+            timing_end[i].end();
+        }
+        LOG_INFO(Render_Vulkan, "GPU timing: on ({} ns per tick)", timing_period_ns);
+    } catch (const std::exception& e) {
+        LOG_WARNING(Render_Vulkan, "GPU timing unavailable: {}", e.what());
+        timing_period_ns = 0.f;
+    }
+}
+
+void MasterSemaphoreLibRetro::ReportGpuTiming(u32 slot, u64 signal_value) {
+    u64 ts[2]{};
+    const vk::Device device{instance.GetDevice()};
+    const vk::Result r = device.getQueryPoolResults(
+        timing_pool, slot * 2, 2, sizeof(ts), ts, sizeof(u64), vk::QueryResultFlagBits::e64);
+    if (r != vk::Result::eSuccess) {
+        return;
+    }
+    const u64 start = ts[0] & timing_mask, end = ts[1] & timing_mask;
+    const double gpu_ms = static_cast<double>((end - start) & timing_mask) * timing_period_ns / 1e6;
+    const double gap_ms = timing_prev_end
+                              ? static_cast<double>((start - timing_prev_end) & timing_mask) *
+                                    timing_period_ns / 1e6
+                              : 0.0;
+    timing_prev_end = end;
+    const double done_ms = std::chrono::duration<double, std::milli>(
+                               std::chrono::steady_clock::now() - timing_submit_time[slot])
+                               .count();
+    static u32 s_logged = 0;
+    static u64 s_count = 0;
+    static double s_worst_gpu = 0, s_worst_gap = 0;
+    ++s_count;
+    s_worst_gpu = std::max(s_worst_gpu, gpu_ms);
+    s_worst_gap = std::max(s_worst_gap, gap_ms);
+    if ((gpu_ms > 40.0 || gap_ms > 100.0 || done_ms > 100.0) && (s_logged < 60 || s_logged % 50 == 0)) {
+        LOG_WARNING(Render_Vulkan,
+                    "GPU timing: submission {} ran {:.1f} ms on the GPU, started {:.1f} ms after "
+                    "the previous one ended, seen done {:.1f} ms after it was submitted",
+                    signal_value, gpu_ms, gap_ms, done_ms);
+        ++s_logged;
+    } else if (gpu_ms > 40.0 || gap_ms > 100.0 || done_ms > 100.0) {
+        ++s_logged;
+    }
+    if (s_count % 1800 == 0) {
+        LOG_INFO(Render_Vulkan, "GPU timing: {} submissions, worst {:.1f} ms on the GPU, worst gap {:.1f} ms",
+                 s_count, s_worst_gpu, s_worst_gap);
+        s_worst_gpu = s_worst_gap = 0;
+    }
+}
