             }
-            std::tie(fence, signal_value) = wait_queue.front();
+            const PendingWork work = wait_queue.front();
+            fence = work.fence;
+            signal_value = work.signal_value;
+            timing_slot = work.timing_slot;
             wait_queue.pop();
         }
 
@@ -894,6 +1009,10 @@ void MasterSemaphoreLibRetro::WaitThread(std::stop_token token) {
             LOG_ERROR(Render_Vulkan, "Fence wait failed: {}", e.what());
         }
 
+        if (timing_slot != ~0u) {
+            ReportGpuTiming(timing_slot, signal_value);
+        }
+
         // Update GPU tick - signals main thread's Wait()
         gpu_tick.store(signal_value, std::memory_order_release);
 
