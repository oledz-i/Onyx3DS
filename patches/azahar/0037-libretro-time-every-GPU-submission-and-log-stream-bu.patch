@@ -819,13 +917,26 @@ void MasterSemaphoreLibRetro::SubmitWork(vk::CommandBuffer cmdbuf, vk::Semaphore
     // Get a fence from the pool
     const vk::Fence fence = GetFreeFence();
 
+    // With GPU timing on, the work is wrapped in two tiny command buffers that
+    // write a timestamp before and after it.
+    u32 timing_slot = ~0u;
+    std::array<vk::CommandBuffer, 3> buffers{cmdbuf, {}, {}};
+    u32 buffer_count = 1;
+    if (timing_period_ns > 0.f) {
+        timing_slot = timing_next;
+        timing_next = (timing_next + 1) % TIMING_SLOTS;
+        buffers = {timing_start[timing_slot], cmdbuf, timing_end[timing_slot]};
+        buffer_count = 3;
+        timing_submit_time[timing_slot] = std::chrono::steady_clock::now();
+    }
+
     // Strip semaphores - RetroArch handles frame sync, we track resources internally
     const vk::SubmitInfo submit_info = {
         .waitSemaphoreCount = 0,
         .pWaitSemaphores = nullptr,
         .pWaitDstStageMask = nullptr,
-        .commandBufferCount = 1u,
-        .pCommandBuffers = &cmdbuf,
+        .commandBufferCount = buffer_count,
+        .pCommandBuffers = buffers.data(),
         .signalSemaphoreCount = 0,
         .pSignalSemaphores = nullptr,
     };
@@ -858,7 +969,7 @@ void MasterSemaphoreLibRetro::SubmitWork(vk::CommandBuffer cmdbuf, vk::Semaphore
