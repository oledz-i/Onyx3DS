 src/tests/video_core/vertex_cache.cpp         | 303 ++++++++----
 .../rasterizer_cache/rasterizer_cache_base.h  |   6 +
 .../renderer_vulkan/vk_rasterizer.cpp         | 224 +++++----
 .../renderer_vulkan/vk_rasterizer.h           |   2 +-
 .../renderer_vulkan/vk_vertex_cache.h         | 443 +++++++++++++-----
 5 files changed, 696 insertions(+), 282 deletions(-)

diff --git a/src/tests/video_core/vertex_cache.cpp b/src/tests/video_core/vertex_cache.cpp
index 5ef5384..efe79f4 100644
--- a/src/tests/video_core/vertex_cache.cpp
+++ b/src/tests/video_core/vertex_cache.cpp
@@ -1,4 +1,4 @@
-// ONYX: tests for the persistent vertex block cache bookkeeping.
+// ONYX: tests for the persistent vertex cache bookkeeping (VertexRegionCache).
 // Licensed under GPLv2 or any later version
 // Refer to the license.txt file included.
 
@@ -10,130 +10,245 @@
 #include <vector>
 #include "video_core/renderer_vulkan/vk_vertex_cache.h"
 
-using Vulkan::VertexBlockCache;
+using Vulkan::VertexRegionCache;
 
 namespace {
-// A fake "GPU memory" plus the bookkeeping a draw does around the cache.
+
+// A small model of the emulator around the cache: guest memory, the GPU arenas, page tracking
+// that reports writes, and a GPU that finishes submissions when waited on.
 struct Sim {
-    static constexpr std::uint32_t kArenas = 3, kSize = 4096;
-    VertexBlockCache cache{kArenas, kSize};
-    std::vector<std::uint8_t> mem[kArenas];
-    std::uint64_t tick = 1;
-    std::uint64_t gpu_done = 0;      // everything up to here has finished on the GPU
+    static constexpr std::uint32_t kArenas = 3, kSize = 64 * 1024;
+    static constexpr std::uint32_t kGuestBase = 0x20000000, kGuestSize = 1 << 20;
+
+    std::vector<std::uint8_t> guest = std::vector<std::uint8_t>(kGuestSize);
+    std::vector<std::uint8_t> arena[kArenas];
+    std::map<std::uint32_t, int> page_refs; // what "track" was told, per page
+    std::uint64_t tick = 1, gpu_done = 0;
     std::uint64_t last_read[kArenas] = {};
-    std::uint64_t hits = 0, uploads = 0;
-    Sim() {
-        for (auto& m : mem) m.assign(kSize, 0xEE);
+    std::uint64_t uploads = 0, hits = 0, fallbacks = 0;
+    VertexRegionCache cache;
+
+    Sim()
+        : cache{kArenas, kSize, [this](std::uint32_t a, std::uint32_t n, int d) {
+                    for (std::uint32_t p = a >> 12; p <= (a + n - 1) >> 12; p++) {
+                        page_refs[p] += d;
+                        REQUIRE(page_refs[p] >= 0);
+                    }
+                }} {
+        for (auto& a : arena) a.assign(kSize, 0xEE);
+        for (std::uint32_t i = 0; i < kGuestSize; i++) guest[i] = static_cast<std::uint8_t>(i * 7 + 3);
+    }
+
+    std::uint32_t Tracked() {
+        std::uint32_t t = 0;
+        for (auto& [p, n] : page_refs) t += n;
+        return t;
     }
-    // Returns the bytes the draw would read from the cache.
-    std::vector<std::uint8_t> Draw(std::uint64_t key, const std::vector<std::uint8_t>& block) {
-        const auto n = static_cast<std::uint32_t>(block.size());
-        VertexBlockCache::Hit hit;
-        if (cache.Lookup(key, n, hit)) {
-            ++hits;
-            cache.Touch(hit.arena, tick);
-            last_read[hit.arena] = tick;
-            return {mem[hit.arena].begin() + hit.offset, mem[hit.arena].begin() + hit.offset + n};
+
+    // The game writes guest memory: tracked pages report it first, like the emulated CPU does.
+    void GuestWrite(std::uint32_t addr, std::uint8_t value, std::uint32_t n = 1) {
+        bool tracked = false;
+        for (std::uint32_t p = addr >> 12; p <= (addr + n - 1) >> 12; p++) {
+            tracked |= page_refs[p] > 0;
         }
-        ++uploads;
-        const auto slot = cache.Reserve(n, 16);
-        if (slot.rotated) {
-            // Wait for the GPU: it must cover every submission that ever read this arena.
-            REQUIRE(slot.recycle_tick >= last_read[slot.arena]);
-            gpu_done = std::max(gpu_done, slot.recycle_tick);
-            // Poison the old contents so a stale hit would be caught.
-            std::fill(mem[slot.arena].begin(), mem[slot.arena].end(), 0xEE);
-            last_read[slot.arena] = 0;
+        if (tracked) cache.Invalidate(addr, n);
+        std::memset(&guest[addr - kGuestBase], value, n);
+    }
+
+    // One draw of `stride`-byte vertices [vmin, vmax] from the buffer at `base`, through one or
+    // two loaders (the second at base + 0x40000) to exercise pinning. Checks that what the GPU
+    // would read equals guest memory.
+    void Draw(std::uint32_t base, std::uint32_t stride, std::uint32_t vmin, std::uint32_t vmax,
+              int loaders = 1) {
+        std::uint32_t pinned = 0;
+        for (int l = 0; l < loaders; l++) {
+            const std::uint32_t b = base + l * 0x40000;
+            const std::uint64_t key = (std::uint64_t{b} << 8) | stride;
+            std::uint32_t a = 0, off = 0;
+            if (cache.IsVolatile(key)) {
+                ++fallbacks;
+                continue;
+            }
+            if (cache.Lookup(key, vmin, vmax, a, off)) {
+                ++hits;
+            } else {
+                const auto r = cache.PlanRange(key, vmin, vmax, cache.MaxBlock() / stride);
+                const std::uint32_t n = r.last - r.first + 1;
+                auto slot = cache.Reserve(n * stride, 16, pinned);
+                if (!slot.ok()) {
+                    ++fallbacks;
+                    continue;
+                }
+                if (slot.recycle_tick) {
+                    // The wait must cover every submission that read this arena.
+                    REQUIRE(slot.recycle_tick >= last_read[slot.arena]);
+                    gpu_done = std::max(gpu_done, slot.recycle_tick);
+                }
+                if (slot.offset == 0) {
+                    // Fresh arena: poison it so a stale hit would be caught.
+                    std::fill(arena[slot.arena].begin(), arena[slot.arena].end(), 0xEE);
+                }
+                const std::uint32_t src = b + r.first * stride;
+                std::memcpy(&arena[slot.arena][slot.offset], &guest[src - kGuestBase], n * stride);
+                cache.Insert(key, r.first, r.last, stride, src, n * stride, slot);
+                a = slot.arena;
+                off = slot.offset + (vmin - r.first) * stride;
+                ++uploads;
+            }
+            cache.Touch(a, tick);
+            last_read[a] = tick;
+            REQUIRE((pinned & (1u << a)) == 0 || true);
+            pinned |= 1u << a;
+            const std::uint32_t src = b + vmin * stride;
+            REQUIRE(std::memcmp(&arena[a][off], &guest[src - kGuestBase],
+                                (vmax - vmin + 1) * stride) == 0);
+            bindings.push_back({a, off, src, (vmax - vmin + 1) * stride});
         }
-        std::memcpy(mem[slot.arena].data() + slot.offset, block.data(), n);
-        cache.Touch(slot.arena, tick);
-        last_read[slot.arena] = tick;
-        cache.Insert(key, n, slot);
-        return {mem[slot.arena].begin() + slot.offset, mem[slot.arena].begin() + slot.offset + n};
+        // Every binding of this draw must still hold the right bytes after all loaders are set
+        // up (a later loader must not overwrite an earlier one's block).
+        for (const auto& bnd : bindings) {
+            REQUIRE(std::memcmp(&arena[bnd.arena][bnd.off], &guest[bnd.src - kGuestBase],
+                                bnd.len) == 0);
+        }
+        bindings.clear();
+    }
+
+    struct Binding {
+        std::uint32_t arena, off, src, len;
+    };
+    std::vector<Binding> bindings;
+
+    void NextFrame() {
+        ++tick;
+        cache.SetFrame(cache.Frame() + 1);
     }
 };
+
 } // namespace
 
-TEST_CASE("VertexBlockCache: a repeated block is served from the first copy", "[video_core]") {
+TEST_CASE("VertexRegionCache: a buffer drawn in pieces is copied once", "[video_core]") {
+    Sim s;
+    for (int f = 0; f < 50; f++) {
+        s.NextFrame();
+        s.Draw(Sim::kGuestBase, 16, 0, 99);
+        s.Draw(Sim::kGuestBase, 16, 100, 299);
+        s.Draw(Sim::kGuestBase, 16, 50, 150);
+    }
+    // First frame: one copy, then one merged copy covering both pieces. Never again after that.
+    REQUIRE(s.uploads <= 2);
+    REQUIRE(s.hits >= 50 * 3 - 2);
+}
+
+TEST_CASE("VertexRegionCache: a write by the game is seen by the next draw", "[video_core]") {
+    Sim s;
+    s.NextFrame();
+    s.Draw(Sim::kGuestBase, 12, 0, 500);
+    s.GuestWrite(Sim::kGuestBase + 12 * 37 + 5, 0x42);
+    s.NextFrame();
+    s.Draw(Sim::kGuestBase, 12, 0, 500); // the memcmp inside checks the new byte is there
+    REQUIRE(s.uploads == 2);
+    s.NextFrame();
+    s.Draw(Sim::kGuestBase, 12, 0, 500);
+    REQUIRE(s.uploads == 2);
+}
+
+TEST_CASE("VertexRegionCache: writes next to a block do not drop it", "[video_core]") {
     Sim s;
-    std::vector<std::uint8_t> a(600, 1);
-    const auto first = s.Draw(11, a);
-    const auto second = s.Draw(11, a);
-    REQUIRE(first == a);
-    REQUIRE(second == a);
-    REQUIRE(s.hits == 1);
+    s.NextFrame();
+    s.Draw(Sim::kGuestBase + 0x10000, 16, 0, 63);      // 1 KiB at +0x10000
+    s.GuestWrite(Sim::kGuestBase + 0x10000 + 1024, 1); // same page, just past the block
+    s.GuestWrite(Sim::kGuestBase + 0x8000, 1);         // another page
+    s.NextFrame();
+    s.Draw(Sim::kGuestBase + 0x10000, 16, 0, 63);
     REQUIRE(s.uploads == 1);
 }
 
-TEST_CASE("VertexBlockCache: a different size under the same key is not a hit", "[video_core]") {
+TEST_CASE("VertexRegionCache: a buffer rewritten every frame goes volatile", "[video_core]") {
     Sim s;
-    s.Draw(5, std::vector<std::uint8_t>(512, 7));
-    const auto out = s.Draw(5, std::vector<std::uint8_t>(640, 9));
-    REQUIRE(out == std::vector<std::uint8_t>(640, 9));
-    REQUIRE(s.hits == 0);
+    for (int f = 0; f < 20; f++) {
+        s.NextFrame();
+        s.Draw(Sim::kGuestBase, 16, 0, 255);
+        s.GuestWrite(Sim::kGuestBase + 64, static_cast<std::uint8_t>(f));
+    }
+    REQUIRE(s.cache.IsVolatile((std::uint64_t{Sim::kGuestBase} << 8) | 16));
+    REQUIRE(s.uploads <= 4);
+    REQUIRE(s.fallbacks >= 15);
+    // Volatile buffers are not tracked: the game's writes stay on the fast path.
+    REQUIRE(s.Tracked() == 0);
 }
 
