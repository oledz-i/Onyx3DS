new file mode 100644
index 0000000..fac899e
--- /dev/null
+++ b/src/video_core/renderer_vulkan/vk_vertex_cache.h
@@ -0,0 +1,187 @@
+// ONYX: persistent vertex block cache (bookkeeping only, no Vulkan in here so it can be tested).
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+#pragma once
+
+#include <array>
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+#include <unordered_map>
+#include <vector>
+
+namespace Vulkan {
+
+/**
+ * Remembers where vertex blocks already live in a set of upload arenas, so a draw whose vertex
+ * bytes were uploaded before (the same track geometry drawn again next frame) points at the old
+ * copy instead of copying the data again.
+ *
+ * The memory is split into a few arenas. Blocks are appended to the active arena; when it is
+ * full the next arena becomes active, everything cached in it is forgotten, and the caller must
+ * first wait for the GPU to finish with the last submission that used it (RecycleTick). A block
+ * is never rewritten while it is cached, so a hit needs no synchronisation beyond Touch().
+ */
+class VertexBlockCache {
+public:
+    static constexpr std::size_t MAX_ARENAS = 8;
+
+    struct Hit {
+        std::uint32_t arena;
+        std::uint32_t offset;
+    };
+
+    struct Slot {
+        std::uint32_t arena;
+        std::uint32_t offset;
+        bool rotated;                 ///< the active arena changed to `arena`
+        std::uint64_t recycle_tick;   ///< wait for this tick before writing (0 = nothing to wait)
+    };
+
+    VertexBlockCache(std::uint32_t arena_count, std::uint32_t arena_size)
+        : count{arena_count > MAX_ARENAS ? static_cast<std::uint32_t>(MAX_ARENAS) : arena_count},
+          size{arena_size} {
+        entries.reserve(4096);
+    }
+
+    std::uint32_t ArenaSize() const {
+        return size;
+    }
+
+    /// Largest block the cache accepts.
+    std::uint32_t MaxBlock() const {
+        return size / 4;
+    }
+
+    bool Lookup(std::uint64_t key, std::uint32_t block_size, Hit& out) const {
+        const auto it = entries.find(key);
+        if (it == entries.end() || it->second.size != block_size) {
+            return false;
+        }
+        out = {it->second.arena, it->second.offset};
+        return true;
+    }
+
+    /// Records that the arena is read by the submission `tick` (call on every hit and write).
+    void Touch(std::uint32_t arena, std::uint64_t tick) {
+        if (tick > last_tick[arena]) {
+            last_tick[arena] = tick;
+        }
+    }
+
+    /// Reserves room for a block. The returned slot is not findable until Insert().
+    Slot Reserve(std::uint32_t block_size, std::uint32_t alignment) {
+        Slot slot{};
+        std::uint32_t at = Align(used, alignment);
+        if (at + block_size > size) {
+            // Move on to the next arena and forget what it held.
+            active = (active + 1) % count;
+            slot.rotated = true;
+            slot.recycle_tick = last_tick[active];
+            last_tick[active] = 0;
+            for (const std::uint64_t key : keys[active]) {
+                const auto it = entries.find(key);
+                if (it != entries.end() && it->second.arena == active) {
+                    entries.erase(it);
+                }
+            }
+            keys[active].clear();
+            used = 0;
+            at = 0;
+            ++rotations;
+        }
+        used = at + block_size;
+        slot.arena = active;
+        slot.offset = at;
+        return slot;
+    }
+
+    void Insert(std::uint64_t key, std::uint32_t block_size, const Slot& slot) {
+        entries[key] = {slot.arena, slot.offset, block_size};
+        keys[slot.arena].push_back(key);
+    }
+
+    std::uint32_t Active() const {
+        return active;
+    }
+    std::uint64_t Rotations() const {
+        return rotations;
+    }
+    std::size_t EntryCount() const {
+        return entries.size();
+    }
+
+    // --- Adaptive switch -------------------------------------------------------------------
+    // Hashing every block only pays when enough of them are found again. Every probe window the
+    // byte hit rate is checked; a poor rate turns the cache off (no hashing, plain uploads) for
+    // a while, then it probes again.
+
+    /// True when the cache should be used for the next draw.
+    bool Enabled(std::chrono::steady_clock::time_point now) {
+        if (bypass_until != std::chrono::steady_clock::time_point{}) {
+            if (now < bypass_until) {
+                return false;
+            }
+            bypass_until = {};
+            window_start = now;
+            window_bytes = window_hit_bytes = 0;
+        }
+        if (window_start == std::chrono::steady_clock::time_point{}) {
+            window_start = now;
+        }
+        return true;
+    }
+
+    /// Reports the outcome of a cached-path draw.
+    void Report(std::chrono::steady_clock::time_point now, std::uint32_t bytes, bool hit) {
+        window_bytes += bytes;
+        if (hit) {
+            window_hit_bytes += bytes;
+        }
+        if (now - window_start >= probe_length) {
+            // Under 20% of the bytes found again: not worth hashing.
+            if (window_hit_bytes * 5 < window_bytes) {
+                bypass_until = now + bypass_length;
+                ++bypassed_windows;
+            }
+            window_start = now;
+            window_bytes = window_hit_bytes = 0;
+        }
+    }
+
+    std::uint64_t BypassedWindows() const {
+        return bypassed_windows;
+    }
+
+    std::chrono::milliseconds probe_length{1000};
+    std::chrono::milliseconds bypass_length{4000};
+
+private:
+    struct Entry {
+        std::uint32_t arena;
+        std::uint32_t offset;
+        std::uint32_t size;
+    };
+
+    static std::uint32_t Align(std::uint32_t v, std::uint32_t a) {
+        return a ? (v + a - 1) / a * a : v;
+    }
+
+    std::uint32_t count;
+    std::uint32_t size;
+    std::uint32_t active{0};
+    std::uint32_t used{0};
+    std::uint64_t rotations{0};
+    std::array<std::uint64_t, MAX_ARENAS> last_tick{};
+    std::array<std::vector<std::uint64_t>, MAX_ARENAS> keys{};
+    std::unordered_map<std::uint64_t, Entry> entries;
+
+    std::chrono::steady_clock::time_point window_start{};
+    std::chrono::steady_clock::time_point bypass_until{};
+    std::uint64_t window_bytes{0};
+    std::uint64_t window_hit_bytes{0};
+    std::uint64_t bypassed_windows{0};
+};
+
+} // namespace Vulkan
