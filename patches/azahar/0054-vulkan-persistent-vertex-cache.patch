+// ONYX: tests for the persistent vertex block cache bookkeeping.
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+#include <catch2/catch_test_macros.hpp>
+#include <cstdint>
+#include <cstring>
+#include <map>
+#include <random>
+#include <vector>
+#include "video_core/renderer_vulkan/vk_vertex_cache.h"
+
+using Vulkan::VertexBlockCache;
+
+namespace {
+// A fake "GPU memory" plus the bookkeeping a draw does around the cache.
+struct Sim {
+    static constexpr std::uint32_t kArenas = 3, kSize = 4096;
+    VertexBlockCache cache{kArenas, kSize};
+    std::vector<std::uint8_t> mem[kArenas];
+    std::uint64_t tick = 1;
+    std::uint64_t gpu_done = 0;      // everything up to here has finished on the GPU
+    std::uint64_t last_read[kArenas] = {};
+    std::uint64_t hits = 0, uploads = 0;
+    Sim() {
+        for (auto& m : mem) m.assign(kSize, 0xEE);
+    }
+    // Returns the bytes the draw would read from the cache.
+    std::vector<std::uint8_t> Draw(std::uint64_t key, const std::vector<std::uint8_t>& block) {
+        const auto n = static_cast<std::uint32_t>(block.size());
+        VertexBlockCache::Hit hit;
+        if (cache.Lookup(key, n, hit)) {
+            ++hits;
+            cache.Touch(hit.arena, tick);
+            last_read[hit.arena] = tick;
+            return {mem[hit.arena].begin() + hit.offset, mem[hit.arena].begin() + hit.offset + n};
+        }
+        ++uploads;
+        const auto slot = cache.Reserve(n, 16);
+        if (slot.rotated) {
+            // Wait for the GPU: it must cover every submission that ever read this arena.
+            REQUIRE(slot.recycle_tick >= last_read[slot.arena]);
+            gpu_done = std::max(gpu_done, slot.recycle_tick);
+            // Poison the old contents so a stale hit would be caught.
+            std::fill(mem[slot.arena].begin(), mem[slot.arena].end(), 0xEE);
+            last_read[slot.arena] = 0;
+        }
+        std::memcpy(mem[slot.arena].data() + slot.offset, block.data(), n);
+        cache.Touch(slot.arena, tick);
+        last_read[slot.arena] = tick;
+        cache.Insert(key, n, slot);
+        return {mem[slot.arena].begin() + slot.offset, mem[slot.arena].begin() + slot.offset + n};
+    }
+};
+} // namespace
+
+TEST_CASE("VertexBlockCache: a repeated block is served from the first copy", "[video_core]") {
+    Sim s;
+    std::vector<std::uint8_t> a(600, 1);
+    const auto first = s.Draw(11, a);
+    const auto second = s.Draw(11, a);
+    REQUIRE(first == a);
+    REQUIRE(second == a);
+    REQUIRE(s.hits == 1);
+    REQUIRE(s.uploads == 1);
+}
+
+TEST_CASE("VertexBlockCache: a different size under the same key is not a hit", "[video_core]") {
+    Sim s;
+    s.Draw(5, std::vector<std::uint8_t>(512, 7));
+    const auto out = s.Draw(5, std::vector<std::uint8_t>(640, 9));
+    REQUIRE(out == std::vector<std::uint8_t>(640, 9));
+    REQUIRE(s.hits == 0);
+}
+
+TEST_CASE("VertexBlockCache: recycled arenas never serve stale data", "[video_core]") {
+    // Random scene: a pool of blocks drawn in random order across many "frames", with ticks
+    // advancing. Every returned block must equal what the draw asked for.
+    std::mt19937 rng(1234);
+    Sim s;
+    std::map<std::uint64_t, std::vector<std::uint8_t>> pool;
+    for (std::uint64_t k = 1; k <= 40; k++) {
+        std::vector<std::uint8_t> b(512 + 16 * (rng() % 40));
+        for (auto& v : b) v = static_cast<std::uint8_t>(rng());
+        pool[k] = b;
+    }
+    for (int frame = 0; frame < 3000; frame++) {
+        ++s.tick;
+        for (int d = 0; d < 6; d++) {
+            const auto k = 1 + rng() % 40;
+            REQUIRE(s.Draw(k, pool[k]) == pool[k]);
+        }
+    }
+    REQUIRE(s.cache.Rotations() > 10);
+    REQUIRE(s.hits > 0);
+}
+
+TEST_CASE("VertexBlockCache: a static scene is almost all hits", "[video_core]") {
+    Sim s;
+    std::vector<std::vector<std::uint8_t>> blocks;
+    for (int i = 0; i < 8; i++) blocks.emplace_back(700, static_cast<std::uint8_t>(i + 1));
+    for (int frame = 0; frame < 100; frame++) {
+        ++s.tick;
+        for (int i = 0; i < 8; i++) REQUIRE(s.Draw(100 + i, blocks[i]) == blocks[i]);
+    }
+    // Eight blocks of 700 B fit in the three arenas without recycling: only the first frame uploads.
+    REQUIRE(s.uploads == 8);
+    REQUIRE(s.hits == 8 * 99);
+}
+
+TEST_CASE("VertexBlockCache: turns itself off when little is found again", "[video_core]") {
+    using clock = std::chrono::steady_clock;
+    VertexBlockCache c{2, 1 << 20};
+    c.probe_length = std::chrono::milliseconds(100);
+    c.bypass_length = std::chrono::milliseconds(500);
+    auto t = clock::now();
+    REQUIRE(c.Enabled(t));
+    for (int i = 0; i < 10; i++) {
+        t += std::chrono::milliseconds(20);
+        c.Report(t, 1000, false); // never a hit
+    }
+    REQUIRE_FALSE(c.Enabled(t + std::chrono::milliseconds(10)));
+    REQUIRE(c.Enabled(t + std::chrono::milliseconds(700))); // probes again later
+    REQUIRE(c.BypassedWindows() >= 1);
+}
+
+TEST_CASE("VertexBlockCache: stays on while hits are common", "[video_core]") {
+    using clock = std::chrono::steady_clock;
+    VertexBlockCache c{2, 1 << 20};
+    c.probe_length = std::chrono::milliseconds(100);
+    auto t = clock::now();
+    REQUIRE(c.Enabled(t));
+    for (int i = 0; i < 50; i++) {
+        t += std::chrono::milliseconds(20);
+        REQUIRE(c.Enabled(t));
+        c.Report(t, 1000, i % 2 == 0);
+    }
+    REQUIRE(c.BypassedWindows() == 0);
+}
