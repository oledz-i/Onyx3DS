+void StreamBuffer::FlushRange(u32 range_offset, u32 range_size) {
+    if (is_coherent) {
+        return;
+    }
+    const u64 atom = instance.NonCoherentAtomSize();
+    const u64 begin = range_offset / atom * atom;
+    u64 end = Common::AlignUp(static_cast<u64>(range_offset) + range_size, atom);
+    end = std::min<u64>(end, stream_buffer_size);
+    device.flushMappedMemoryRanges(vk::MappedMemoryRange{
+        .memory = memory,
+        .offset = begin,
+        .size = end - begin,
+    });
