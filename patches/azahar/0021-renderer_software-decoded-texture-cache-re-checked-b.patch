+std::shared_ptr<const RasterizerSoftware::DecodedTexture> RasterizerSoftware::GetDecodedTexture(
+    const Pica::TexturingRegs::FullTextureConfig& texture) {
+    const u32 width = texture.config.width;
+    const u32 height = texture.config.height;
+    if (width == 0 || height == 0 || width > 1024 || height > 1024) {
+        return nullptr;
+    }
+    const PAddr address = texture.config.GetPhysicalAddress();
+    const auto info = TextureInfo::FromPicaRegister(texture.config, texture.format);
+    const u32 size = static_cast<u32>(Pica::Texture::CalculateTileSize(texture.format) *
+                                      (width / 8) * (height / 8));
+    const u8* data = memory.GetPhysicalPointer(address);
+    if (!data || size == 0 || !memory.IsValidPhysicalAddress(address + size - 1)) {
+        return nullptr;
+    }
+    ++texture_use_counter;
+    for (auto& entry : decoded_textures) {
+        if (entry->address != address || entry->width != width || entry->height != height ||
+            entry->size != size || entry->format != texture.format) {
+            continue;
+        }
+        if (entry->checked != texture_epoch) {
+            // First use this frame: make sure the game hasn't rewritten it.
+            if (Common::ComputeHash64(data, size) != entry->hash) {
+                break; // stale: re-decode below
+            }
+            entry->checked = texture_epoch;
+        }
+        entry->last_used = texture_use_counter;
+        return entry;
+    }
+
+    // Decode (rows in parallel), replacing a stale copy of the same texture if any.
+    auto fresh = std::make_shared<DecodedTexture>();
+    fresh->width = width;
+    fresh->height = height;
+    fresh->address = address;
+    fresh->size = size;
+    fresh->format = texture.format;
+    fresh->hash = Common::ComputeHash64(data, size);
+    fresh->checked = texture_epoch;
+    fresh->last_used = texture_use_counter;
+    fresh->texels.resize(static_cast<std::size_t>(width) * height);
+    u32* out = fresh->texels.data();
+    constexpr u32 kRowsPerTask = 32;
+    const u32 tasks = (height + kRowsPerTask - 1) / kRowsPerTask;
+    ParallelFor(tasks, [&](u32 task) {
+        const u32 y0 = task * kRowsPerTask;
+        const u32 y1 = std::min(height, y0 + kRowsPerTask);
+        for (u32 y = y0; y < y1; ++y) {
+            for (u32 x = 0; x < width; ++x) {
+                const auto c = LookupTexture(data, x, y, info);
+                out[static_cast<std::size_t>(y) * width + x] =
+                    static_cast<u32>(c.r()) | (static_cast<u32>(c.g()) << 8) |
+                    (static_cast<u32>(c.b()) << 16) | (static_cast<u32>(c.a()) << 24);
+            }
+        }
+    });
+
+    std::erase_if(decoded_textures, [&](const std::shared_ptr<DecodedTexture>& e) {
+        if (e->address == address && e->width == width && e->height == height) {
+            decoded_bytes -= e->texels.size() * 4;
+            return true;
+        }
+        return false;
+    });
+    decoded_bytes += fresh->texels.size() * 4;
+    decoded_textures.push_back(fresh);
+    // Keep the cache bounded (draws in flight keep their own references).
+    constexpr std::size_t kMaxDecodedBytes = 96u << 20;
+    while (decoded_bytes > kMaxDecodedBytes && decoded_textures.size() > 1) {
+        auto oldest = std::min_element(decoded_textures.begin(), decoded_textures.end(),
+                                       [](const auto& a, const auto& b) {
+                                           return a->last_used < b->last_used;
+                                       });
+        decoded_bytes -= (*oldest)->texels.size() * 4;
+        decoded_textures.erase(oldest);
+    }
+    return fresh;
+}
+
+void RasterizerSoftware::InvalidateDecodedTextures(PAddr addr, u32 size) {
+    if (size == 0) {
+        return;
+    }
+    std::erase_if(decoded_textures, [&](const std::shared_ptr<DecodedTexture>& e) {
+        if (e->address < addr + size && addr < e->address + e->size) {
+            decoded_bytes -= e->texels.size() * 4;
+            return true;
+        }
+        return false;
+    });
+}
