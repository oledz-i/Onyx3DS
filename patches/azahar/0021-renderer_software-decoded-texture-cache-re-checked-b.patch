+public:
+    /// A texture decoded to RGBA8 once and sampled by index afterwards.
+    struct DecodedTexture {
+        std::vector<u32> texels; ///< texels[t * width + s], same s/t as LookupTexture
+        u32 width = 0;
+        u32 height = 0;
+        PAddr address = 0;
+        u32 size = 0;    ///< Source bytes
+        Pica::TexturingRegs::TextureFormat format{};
+        u64 hash = 0;    ///< Of the source bytes when decoded
+        u64 checked = 0; ///< Epoch in which the source was last confirmed unchanged
+        u64 last_used = 0;
+    };
+    using DecodedTextures = std::array<std::shared_ptr<const DecodedTexture>, 3>;
+
+private:
+    /// Returns the decoded copy of a texture unit's 2D texture (nullptr when it can't be).
+    std::shared_ptr<const DecodedTexture> GetDecodedTexture(
+        const Pica::TexturingRegs::FullTextureConfig& texture);
+    /// Drops decoded textures overlapping memory that changed.
+    void InvalidateDecodedTextures(PAddr addr, u32 size);
+
     /// Returns the texture color of the currently processed pixel.
     std::array<Common::Vec4<u8>, 4> TextureColor(
         std::span<const Common::Vec2<f24>, 3> uv,
-        std::span<const Pica::TexturingRegs::FullTextureConfig, 3> textures, f24 tc0_w) const;
