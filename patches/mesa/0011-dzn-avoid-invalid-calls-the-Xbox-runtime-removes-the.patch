       rtve->key = key;
       dzn_descriptor_heap_pool_alloc_slots(&cmdbuf->rtvs.pool, device, 1, &heap, &slot);
       rtve->handle = dzn_descriptor_heap_get_cpu_handle(heap, slot);
-      { ID3D12Device1_CreateRenderTargetView(device->dev, image->res, desc, rtve->handle); DZN_TRACE("CreateRenderTargetView"); }
+      ID3D12Resource *rt_res =
+         dzn_view_format_allowed(device, image, desc->Format, "RTV") ? image->res : NULL;
+      { ID3D12Device1_CreateRenderTargetView(device->dev, rt_res, desc, rtve->handle); DZN_TRACE("CreateRenderTargetView"); }
       he = _mesa_hash_table_insert(cmdbuf->rtvs.ht, &rtve->key, rtve);
    } else {
       rtve = he->data;
diff --git a/src/microsoft/vulkan/dzn_descriptor_set.c b/src/microsoft/vulkan/dzn_descriptor_set.c
index 143496d..ba9124f 100644
--- a/src/microsoft/vulkan/dzn_descriptor_set.c
+++ b/src/microsoft/vulkan/dzn_descriptor_set.c
@@ -995,9 +995,78 @@ dzn_descriptor_heap_write_sampler_desc(struct dzn_device *device,
    if (device->dev11 && pdev->options14.AdvancedTextureOpsSupported)
       { ID3D12Device11_CreateSampler2(device->dev11, &sampler->desc,
                                     dzn_descriptor_heap_get_cpu_handle(heap, desc_offset)); DZN_TRACE("CreateSampler2"); }
-   else
-      { ID3D12Device1_CreateSampler(device->dev, (D3D12_SAMPLER_DESC *)&sampler->desc,
+   else {
+      /* ONYX: the plain call has no flags field, so an integer border colour
+       * would be read as floats (alpha 1 -> a denormal). Convert it. */
+      D3D12_SAMPLER_DESC desc;
+      memcpy(&desc, &sampler->desc, sizeof(desc));
+      if (sampler->desc.Flags & D3D12_SAMPLER_FLAG_UINT_BORDER_COLOR) {
+         for (unsigned i = 0; i < 4; i++)
+            desc.BorderColor[i] = (float)sampler->desc.UintBorderColor[i];
+      }
+      { ID3D12Device1_CreateSampler(device->dev, &desc,
                                   dzn_descriptor_heap_get_cpu_handle(heap, desc_offset)); DZN_TRACE("CreateSampler"); }
+   }
+}
+
+/* ONYX: without relaxed format casting (no Agility SDK on Xbox), D3D12 only
+ * allows views in the resource's own typeless family. A mutable RGBA8 image
+ * viewed as R32_UINT (Azahar's shadow storage view) is an invalid call, and
+ * the Xbox runtime removes the whole device for it. Detect that and write a
+ * null descriptor of the same shape instead. */
+static bool
+dzn_is_known_typeless_family(DXGI_FORMAT fmt)
+{
+   switch (fmt) {
+   case DXGI_FORMAT_R32G32B32A32_TYPELESS:
+   case DXGI_FORMAT_R32G32B32_TYPELESS:
+   case DXGI_FORMAT_R16G16B16A16_TYPELESS:
+   case DXGI_FORMAT_R32G32_TYPELESS:
+   case DXGI_FORMAT_R32G8X24_TYPELESS:
+   case DXGI_FORMAT_R10G10B10A2_TYPELESS:
+   case DXGI_FORMAT_R8G8B8A8_TYPELESS:
+   case DXGI_FORMAT_R16G16_TYPELESS:
+   case DXGI_FORMAT_R32_TYPELESS:
+   case DXGI_FORMAT_R24G8_TYPELESS:
+   case DXGI_FORMAT_R8G8_TYPELESS:
+   case DXGI_FORMAT_R16_TYPELESS:
+   case DXGI_FORMAT_R8_TYPELESS:
+   case DXGI_FORMAT_B8G8R8A8_TYPELESS:
+   case DXGI_FORMAT_B8G8R8X8_TYPELESS:
+      return true;
+   default:
+      return false;
+   }
+}
+
+bool
+dzn_view_format_allowed(const struct dzn_device *device, const struct dzn_image *image,
+                        DXGI_FORMAT view_format, const char *what)
+{
+   const struct dzn_physical_device *pdev =
+      container_of(device->vk.physical, struct dzn_physical_device, vk);
+   if (pdev->options12.RelaxedFormatCastingSupported || !image->res)
+      return true;
+
+   DXGI_FORMAT res_format = image->desc.Format;
+   if (view_format == DXGI_FORMAT_UNKNOWN || view_format == res_format)
+      return true;
+
+   DXGI_FORMAT res_family = dzn_get_typeless_dxgi_format(res_format);
+   DXGI_FORMAT view_family = dzn_get_typeless_dxgi_format(view_format);
+   if (!dzn_is_known_typeless_family(res_family) ||
+       !dzn_is_known_typeless_family(view_family) ||
+       res_family == view_family)
+      return true;
+
+   static unsigned warned;
+   if (warned < 4) {
+      warned++;
+      mesa_logw("dzn: %s view format %d can't be cast from resource format %d on this "
+                "GPU; using a null descriptor instead of an invalid call",
+                what, (int)view_format, (int)res_format);
+   }
+   return false;
 }
 
 void
@@ -1012,7 +1081,20 @@ dzn_descriptor_heap_write_image_view_desc(struct dzn_device *device,
    struct dzn_image *image = container_of(iview->vk.image, struct dzn_image, vk);
 
    if (writeable) {
-      { ID3D12Device1_CreateUnorderedAccessView(device->dev, image->res, NULL, &iview->uav_desc, view_handle); DZN_TRACE("CreateUnorderedAccessView"); }
+      ID3D12Resource *res =
+         dzn_view_format_allowed(device, image, iview->uav_desc.Format, "UAV") ? image->res : NULL;
+      { ID3D12Device1_CreateUnorderedAccessView(device->dev, res, NULL, &iview->uav_desc, view_handle); DZN_TRACE("CreateUnorderedAccessView"); }
+   } else if (!dzn_view_format_allowed(device, image, iview->srv_desc.Format, "SRV")) {
+      D3D12_SHADER_RESOURCE_VIEW_DESC srv_desc = iview->srv_desc;
+      if (cube_as_2darray &&
+          (srv_desc.ViewDimension == D3D12_SRV_DIMENSION_TEXTURECUBEARRAY ||
+           srv_desc.ViewDimension == D3D12_SRV_DIMENSION_TEXTURECUBE)) {
+         memset(&srv_desc.Texture2DArray, 0, sizeof(srv_desc.Texture2DArray));
+         srv_desc.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2DARRAY;
+         srv_desc.Texture2DArray.MipLevels = 1;
+         srv_desc.Texture2DArray.ArraySize = 6;
+      }
+      { ID3D12Device1_CreateShaderResourceView(device->dev, NULL, &srv_desc, view_handle); DZN_TRACE("CreateShaderResourceView(null)"); }
    } else if (cube_as_2darray &&
               (iview->srv_desc.ViewDimension == D3D12_SRV_DIMENSION_TEXTURECUBEARRAY ||
                iview->srv_desc.ViewDimension == D3D12_SRV_DIMENSION_TEXTURECUBE)) {
