          HRESULT hr = DZN_HR(device->dev, "CreatePlacedResource", ID3D12Device1_CreatePlacedResource(device->dev, mem->heap, 0, &res_desc,
                                                          D3D12_RESOURCE_STATE_COMMON,
diff --git a/src/microsoft/vulkan/dzn_pipeline.c b/src/microsoft/vulkan/dzn_pipeline.c
index 6449191..9a879c3 100644
--- a/src/microsoft/vulkan/dzn_pipeline.c
+++ b/src/microsoft/vulkan/dzn_pipeline.c
@@ -22,6 +22,7 @@
  */
 
 #include "dzn_private.h"
+#include "dxil_nir_lower_int_samplers.h"
 
 #include "spirv/nir_spirv.h"
 
@@ -273,6 +274,25 @@ dzn_pipeline_get_nir_shader(struct dzn_device *device,
 
    dxil_spirv_nir_passes(*nir, &conf, metadata);
 
+   /* ONYX: D3D12 can't sample integer textures (the validator refuses
+    * sample_* returning ints, and the result is undefined if signed anyway).
+    * Turn them into texel fetches, clamped to the edge, at LOD 0. */
+   {
+      static dxil_wrap_sampler_state int_wrap[64];
+      static bool int_wrap_init;
+      if (!int_wrap_init) {
+         for (unsigned i = 0; i < ARRAY_SIZE(int_wrap); i++) {
+            int_wrap[i].max_lod = 1000.0f;
+            int_wrap[i].wrap[0] = int_wrap[i].wrap[1] = int_wrap[i].wrap[2] =
+               DXIL_TEX_WRAP_CLAMP_TO_EDGE;
+            int_wrap[i].is_int_sampler = 1;
+         }
+         int_wrap_init = true;
+      }
+      NIR_PASS(_, *nir, dxil_lower_sample_to_txf_for_integer_tex,
+               ARRAY_SIZE(int_wrap), int_wrap, NULL, 0.0f);
+   }
+
    if (stage == MESA_SHADER_VERTEX) {
       bool needs_conv = false;
       for (uint32_t i = 0; i < MAX_VERTEX_GENERIC_ATTRIBS; i++) {
