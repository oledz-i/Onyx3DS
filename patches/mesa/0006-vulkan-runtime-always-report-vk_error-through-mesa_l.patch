From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 4 Oct 2026 15:00:26 -0400
Subject: [PATCH 6/7] vulkan/runtime: always report vk_error() through mesa_log

Release builds only forward vk_error()/vk_errorf() to VK_EXT_debug_utils
callbacks, so applications without a messenger never learn why a call
failed. Log file:line, the VkResult and the message with mesa_loge() too.
---
 src/vulkan/runtime/vk_log.c | 25 +++++++++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/src/vulkan/runtime/vk_log.c b/src/vulkan/runtime/vk_log.c
index 2442219..5fe0acb 100644
--- a/src/vulkan/runtime/vk_log.c
+++ b/src/vulkan/runtime/vk_log.c
@@ -34,6 +34,9 @@
 #include "util/ralloc.h"
 #include "util/log.h"
 
+#include <stdarg.h>
+#include <stdio.h>
+
 static struct vk_device *
 vk_object_to_device(struct vk_object_base *obj)
 {
@@ -313,6 +316,28 @@ __vk_errorv(const void *_obj, VkResult error,
 
    const char *error_str = vk_Result_to_str(error);
 
+   /* Always report driver errors through mesa_log, even in release builds
+    * without VK_EXT_debug_utils: on some platforms (UWP) this is the only
+    * diagnostic channel the application can see.
+    */
+   {
+      char detail[512];
+      detail[0] = '\0';
+      if (format) {
+         va_list copy;
+         va_copy(copy, va);
+         vsnprintf(detail, sizeof(detail), format, copy);
+         va_end(copy);
+      }
+      const char *base = file ? file : "?";
+      for (const char *p = base; *p; p++) {
+         if (*p == '/' || *p == '\\')
+            base = p + 1;
+      }
+      mesa_loge("%s:%d: %s%s%s", base, line, error_str,
+                detail[0] ? ": " : "", detail);
+   }
+
    /* From the Vulkan 1.3.295 spec:
     *
     *    "VK_DEBUG_UTILS_MESSAGE_SEVERITY_WARNING_BIT_EXT specifies use of
