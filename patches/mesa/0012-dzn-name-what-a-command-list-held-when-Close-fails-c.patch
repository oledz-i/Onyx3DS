+
+void
+dzn_cmd_dump_notes(struct dzn_cmd_buffer *cmdbuf, const char *why)
+{
+   const uint32_t n = cmdbuf->onyx_note_count;
+   const uint32_t first = n > DZN_CMD_NOTE_RING ? n - DZN_CMD_NOTE_RING : 0;
+   mesa_loge("dzn: %s: the command list held %u D3D12 calls; the last %u, oldest first:",
+             why, n, n - first);
+   char line[512];
+   size_t len = 0;
+   line[0] = 0;
+   for (uint32_t i = first; i < n;) {
+      const char *what = cmdbuf->onyx_notes[i % DZN_CMD_NOTE_RING];
+      uint32_t repeat = 1;
+      while (i + repeat < n && cmdbuf->onyx_notes[(i + repeat) % DZN_CMD_NOTE_RING] == what)
+         repeat++;
+      char item[96];
+      if (repeat > 1)
+         snprintf(item, sizeof(item), "%s x%u, ", what ? what : "?", repeat);
+      else
+         snprintf(item, sizeof(item), "%s, ", what ? what : "?");
+      const size_t il = strlen(item);
+      if (len + il >= sizeof(line) - 1) {
+         mesa_loge("dzn:   %s", line);
+         len = 0;
+         line[0] = 0;
+      }
+      memcpy(line + len, item, il + 1);
+      len += il;
+      i += repeat;
+   }
+   if (len)
+      mesa_loge("dzn:   %s", line);
 }
 
