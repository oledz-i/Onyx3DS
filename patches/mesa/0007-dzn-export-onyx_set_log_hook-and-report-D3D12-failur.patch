index 0c4a39b..6c14d12 100644
--- a/src/microsoft/vulkan/dzn_util.c
+++ b/src/microsoft/vulkan/dzn_util.c
@@ -28,6 +28,53 @@
 
 #include <util/u_dl.h>
 
+static const char *
+dzn_log_basename(const char *file)
+{
+   const char *base = file ? file : "?";
+   for (const char *p = base; *p; p++) {
+      if (*p == '/' || *p == '\\')
+         base = p + 1;
+   }
+   return base;
+}
+
+HRESULT
+dzn_check_device_removed(ID3D12Device4 *dev, const char *context, uint64_t index)
+{
+   static bool reported;
+
+   if (!dev)
+      return S_OK;
+
+   HRESULT reason = ID3D12Device4_GetDeviceRemovedReason(dev);
+   if (FAILED(reason) && !reported) {
+      reported = true;
+      if (index)
+         mesa_loge("dzn: D3D12 device removed, reason 0x%08lx, first noticed after %s #%llu",
+                   (unsigned long)reason, context ? context : "?",
+                   (unsigned long long)index);
+      else
+         mesa_loge("dzn: D3D12 device removed, reason 0x%08lx, first noticed after %s",
+                   (unsigned long)reason, context ? context : "?");
+   }
+   return reason;
+}
+
+HRESULT
+dzn_log_hresult(ID3D12Device4 *dev, HRESULT hr, const char *what,
+                const char *file, int line)
+{
+   if (SUCCEEDED(hr))
+      return hr;
+
+   mesa_loge("dzn: %s:%d: %s failed, HRESULT 0x%08lx",
+             dzn_log_basename(file), line, what ? what : "D3D12 call",
+             (unsigned long)hr);
+   dzn_check_device_removed(dev, what ? what : "D3D12 call", 0);
+   return hr;
+}
+
