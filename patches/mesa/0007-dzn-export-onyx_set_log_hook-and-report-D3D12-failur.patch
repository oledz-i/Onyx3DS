+/* Lets an application that cannot see stderr or the debugger output (UWP)
+ * receive every Mesa log message. Looked up with GetProcAddress, so it is
+ * exported by name in addition to the .def file's ICD entry points. */
+#ifdef _WIN32
+#define DZN_APP_EXPORT __declspec(dllexport)
+#else
+#define DZN_APP_EXPORT PUBLIC
+#endif
+
+DZN_APP_EXPORT void
+onyx_set_log_hook(void (*hook)(int level, const char *msg));
+
+DZN_APP_EXPORT void
+onyx_set_log_hook(void (*hook)(int level, const char *msg))
+{
+   g_mesa_log_hook = hook;
+   if (hook)
+      mesa_logi("dzn: log hook installed (Mesa " PACKAGE_VERSION MESA_GIT_SHA1 ")");
+}
