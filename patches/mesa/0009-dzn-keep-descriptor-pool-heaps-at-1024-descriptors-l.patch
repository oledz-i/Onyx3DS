From fba294ce00bac3f137dd8d7c583baaa9c36fc5fb Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 4 Oct 2026 21:52:22 -0400
Subject: [PATCH] dzn: keep descriptor-pool heaps at 1024 descriptors (large
 ones removed the device on Xbox); log heap creations

---
 src/microsoft/vulkan/dzn_descriptor_set.c | 25 +++++++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/src/microsoft/vulkan/dzn_descriptor_set.c b/src/microsoft/vulkan/dzn_descriptor_set.c
index 36770f6..fc25dde 100644
--- a/src/microsoft/vulkan/dzn_descriptor_set.c
+++ b/src/microsoft/vulkan/dzn_descriptor_set.c
@@ -31,6 +31,9 @@
 
 #include "util/mesa-blake3.h"
 
+/* See dzn_descriptor_pool_create. */
+#define ONYX_MAX_POOL_HEAP_DESCS 1024u
+
 static uint32_t
 translate_desc_stages(VkShaderStageFlags in)
 {
@@ -930,6 +933,13 @@ dzn_descriptor_heap_init(struct dzn_descriptor_heap *heap,
    heap->desc_count = desc_count;
    heap->desc_sz = ID3D12Device1_GetDescriptorHandleIncrementSize(device->dev, type);
 
+   {
+      static int logged = 0;
+      if (logged++ < 40)
+         mesa_logi("dzn: CreateDescriptorHeap type %d, %u descriptors, %s", (int)type, desc_count,
+                   shader_visible ? "shader-visible" : "CPU-only");
+   }
+
    D3D12_DESCRIPTOR_HEAP_DESC desc = {
       .Type = type,
       .NumDescriptors = desc_count,
@@ -1825,6 +1835,21 @@ dzn_descriptor_pool_create(struct dzn_device *device,
          ID3D12Resource_Map(pool->bindless.buf, 0, NULL, (void **)&pool->bindless.map);
       }
    } else {
+      /* ONYX: on Xbox, creating Azahar's texture descriptor pool (12288 CPU-only
+       * CBV/SRV/UAV and sampler descriptors) removed the D3D12 device
+       * (DXGI_ERROR_INVALID_CALL), while a 384-descriptor pool worked. Keep every
+       * pool heap small: a full pool reports VK_ERROR_OUT_OF_POOL_MEMORY and the
+       * app creates another one. */
+      dzn_foreach_pool_type(type) {
+         const uint32_t cap = ONYX_MAX_POOL_HEAP_DESCS;
+         if (pool->desc_count[type] > cap) {
+            static int logged = 0;
+            if (logged++ < 4)
+               mesa_logi("dzn: capping descriptor pool heap type %d at %u (asked for %u)",
+                         (int)type, cap, pool->desc_count[type]);
+            pool->desc_count[type] = cap;
+         }
+      }
       dzn_foreach_pool_type(type) {
          if (!pool->desc_count[type])
             continue;
-- 
2.43.0

