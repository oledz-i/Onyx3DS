+ID3D12Device4 *dzn_trace_dev;
+
+void
+dzn_trace_set_device(ID3D12Device4 *dev)
+{
+   /* Keep our own reference, so a destroyed VkDevice never leaves a dangling
+    * pointer here. */
+   if (dev == dzn_trace_dev)
+      return;
+   if (dev)
+      ID3D12Device4_AddRef(dev);
+   ID3D12Device4 *old = dzn_trace_dev;
+   dzn_trace_dev = dev;
+   if (old)
+      ID3D12Device4_Release(old);
+}
+
+#define DZN_TRACE_RING 16
+
+void
+dzn_trace_call(const char *what, const char *file, int line)
+{
+   /* Last calls before the removal, for context. Races between threads only
+    * blur this history, which is fine for a diagnostic. */
+   static const char *recent_what[DZN_TRACE_RING];
+   static const char *recent_file[DZN_TRACE_RING];
+   static int recent_line[DZN_TRACE_RING];
+   static unsigned recent_count;
+   static bool reported;
+
+   ID3D12Device4 *dev = dzn_trace_dev;
+   if (reported || !dev)
+      return;
+   unsigned n = p_atomic_inc_return(&recent_count);
+   recent_what[(n - 1) % DZN_TRACE_RING] = what;
+   recent_file[(n - 1) % DZN_TRACE_RING] = file;
+   recent_line[(n - 1) % DZN_TRACE_RING] = line;
+
+   /* Check every call while a game starts (where the Xbox crash happens),
+    * then every 16th call so gameplay doesn't pay for it. */
+   if (n > 300000 && (n & 15))
+      return;
+
+   HRESULT reason = ID3D12Device4_GetDeviceRemovedReason(dev);
+   if (SUCCEEDED(reason))
+      return;
+   reported = true;
+   mesa_loge("dzn: D3D12 device removed (reason 0x%08lx) right after %s at %s:%d (call #%u)",
+             (unsigned long)reason, what ? what : "?", dzn_log_basename(file), line, n);
+   for (unsigned i = n > DZN_TRACE_RING ? n - DZN_TRACE_RING : 0; i + 1 < n; i++) {
+      unsigned k = i % DZN_TRACE_RING;
+      mesa_loge("dzn:   earlier call #%u: %s (%s:%d)", i + 1,
+                recent_what[k] ? recent_what[k] : "?",
+                recent_file[k] ? dzn_log_basename(recent_file[k]) : "?", recent_line[k]);
+   }
+}
+
 HRESULT
 dzn_log_hresult(ID3D12Device4 *dev, HRESULT hr, const char *what,
                 const char *file, int line)
 {
+   if (!dzn_trace_dev && dev)
+      dzn_trace_set_device(dev);
+   dzn_trace_call(what, file, line);
    if (SUCCEEDED(hr))
       return hr;
 
