<Page
    x:Class="ONYX3DS.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Header (mark, title, status chips), section list on the left, the
         selected section in a card on the right, button hints at the bottom.
         Everything inside is built in SettingsPage.cpp. -->
    <Grid x:Name="Root">
        <Image x:Name="BackgroundImage" Stretch="UniformToFill" Opacity="0.55" />
        <Rectangle x:Name="Scrim" IsHitTestVisible="False" />
        <Grid Margin="96,40,96,28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid x:Name="Header" Grid.ColumnSpan="2" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal" Spacing="20">
                    <Border x:Name="MarkHost" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="PageTitle" Text="Settings" FontSize="44" FontWeight="SemiBold" />
                        <TextBlock x:Name="PageSubtitle" FontSize="18" />
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="ChipHost" Orientation="Horizontal" Spacing="10"
                            HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <ListView x:Name="SectionList" Grid.Row="1" SelectionMode="Single"
                      IsItemClickEnabled="True" Margin="0,0,32,0" />
            <Border x:Name="ContentCard" Grid.Row="1" Grid.Column="1" CornerRadius="24"
                    BorderThickness="1" Padding="44,16,40,24">
                <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto"
                              XYFocusLeftNavigationStrategy="NavigationDirectionDistance">
                    <StackPanel x:Name="ContentPanel" Spacing="2" Margin="0,0,24,0" />
                </ScrollViewer>
            </Border>
            <Border x:Name="HintHost" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,18,0,0"
                    HorizontalAlignment="Left" />
        </Grid>
        <StackPanel x:Name="ToastHost" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,48,96,0" IsHitTestVisible="False" />
    </Grid>
</Page>
