<Page
    x:Class="ONYX3DS.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root">
        <Image x:Name="BackgroundImage" Stretch="UniformToFill" Opacity="0.55" />
        <Grid Margin="96,48,96,40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="PageTitle" Text="Settings" FontSize="44" FontWeight="SemiBold"
                       Margin="0,0,0,24" />
            <ListView x:Name="SectionList" Grid.Row="1" SelectionMode="Single"
                      IsItemClickEnabled="True" Margin="0,0,32,0" />
            <Border x:Name="ContentCard" Grid.Row="1" Grid.Column="1" CornerRadius="20" Padding="40,16,40,24">
                <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto"
                              XYFocusLeftNavigationStrategy="NavigationDirectionDistance">
                    <StackPanel x:Name="ContentPanel" Spacing="4" Margin="0,0,24,0" />
                </ScrollViewer>
            </Border>
        </Grid>
        <StackPanel x:Name="ToastHost" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,48,96,0" IsHitTestVisible="False" />
    </Grid>
</Page>
