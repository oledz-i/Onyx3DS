<?xml version="1.0" encoding="utf-8"?>
<!--
  ONYX 3DS - UWP app for Xbox Dev Mode (C++/WinRT, XAML).
  Build the dependencies first (tools\build-all.ps1 does everything), which
  fills ..\..\deps with:
    lib\azahar_all.lib   Azahar libretro core + its libraries, static, UWP
    lib\onyx_shell.lib   portable shell (library, settings, cheats, art, RA)
    lib\rcheevos.lib
    bin\vulkan_dzn.dll   Mesa Dozen (Vulkan on D3D12), built for UWP
    bin\dxil.dll         DXIL signer from the DirectX Shader Compiler
    azahar\              patched Azahar source (headers only are used here)
-->
<Project DefaultTargets="Build" ToolsVersion="17.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="..\packages\Microsoft.Windows.CppWinRT.2.0.240405.15\build\native\Microsoft.Windows.CppWinRT.props" Condition="Exists('..\packages\Microsoft.Windows.CppWinRT.2.0.240405.15\build\native\Microsoft.Windows.CppWinRT.props')" />
  <PropertyGroup Label="Globals">
    <CppWinRTOptimized>true</CppWinRTOptimized>
    <CppWinRTRootNamespaceAutoMerge>true</CppWinRTRootNamespaceAutoMerge>
    <CppWinRTGenerateWindowsMetadata>true</CppWinRTGenerateWindowsMetadata>
    <MinimalCoreWin>true</MinimalCoreWin>
    <ProjectGuid>{6F3A9C1E-2B7D-4E55-9A0C-3D8E1F2A4B60}</ProjectGuid>
    <ProjectName>ONYX3DS</ProjectName>
    <RootNamespace>ONYX3DS</RootNamespace>
    <DefaultLanguage>en-US</DefaultLanguage>
    <MinimumVisualStudioVersion>17.0</MinimumVisualStudioVersion>
    <AppContainerApplication>true</AppContainerApplication>
    <ApplicationType>Windows Store</ApplicationType>
    <ApplicationTypeRevision>10.0</ApplicationTypeRevision>
    <WindowsTargetPlatformVersion Condition=" '$(WindowsTargetPlatformVersion)' == '' ">10.0.22621.0</WindowsTargetPlatformVersion>
    <WindowsTargetPlatformMinVersion>10.0.19041.0</WindowsTargetPlatformMinVersion>
    <OnyxDeps Condition="'$(OnyxDeps)' == ''">$(MSBuildThisFileDirectory)..\..\deps\</OnyxDeps>
    <AzaharSrc Condition="'$(AzaharSrc)' == ''">$(OnyxDeps)azahar\</AzaharSrc>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <UseDebugLibraries>true</UseDebugLibraries>
    <LinkIncremental>true</LinkIncremental>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>false</WholeProgramOptimization>
    <LinkIncremental>false</LinkIncremental>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup>
    <PackageCertificateKeyFile Condition="Exists('$(MSBuildThisFileDirectory)ONYX3DS_TemporaryKey.pfx')">ONYX3DS_TemporaryKey.pfx</PackageCertificateKeyFile>
    <AppxPackageSigningEnabled Condition="Exists('$(MSBuildThisFileDirectory)ONYX3DS_TemporaryKey.pfx')">true</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
    <AppxBundlePlatforms>x64</AppxBundlePlatforms>
    <UapAppxPackageBuildMode>SideloadOnly</UapAppxPackageBuildMode>
    <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
    <AppxPackageDir>$(MSBuildThisFileDirectory)..\..\out\AppPackages\</AppxPackageDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>pch.h</PrecompiledHeaderFile>
      <PrecompiledHeaderOutputFile>$(IntDir)pch.pch</PrecompiledHeaderOutputFile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <WarningLevel>Level4</WarningLevel>
      <AdditionalOptions>%(AdditionalOptions) /bigobj /utf-8 /permissive- /Zc:__cplusplus</AdditionalOptions>
      <PreprocessorDefinitions>NOMINMAX;WIN32_LEAN_AND_MEAN;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(ProjectDir);$(IntDir);$(ProjectDir)..\..\shell\include;$(ProjectDir)..\..\third_party;$(OnyxDeps)headers\Vulkan-Headers\include;$(OnyxDeps)headers\libretro-common\include;$(AzaharSrc)externals\vulkan-headers\include;$(AzaharSrc)externals\libretro-common\libretro-common\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <DisableSpecificWarnings>4100;4201;4324;%(DisableSpecificWarnings)</DisableSpecificWarnings>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateWindowsMetadata>false</GenerateWindowsMetadata>
      <!-- Crash lines in onyx.log give ONYX3DS.exe+offset; the map turns that into a function. -->
      <GenerateMapFile>true</GenerateMapFile>
      <MapFileName>$(ProjectDir)..\..\out\ONYX3DS.map</MapFileName>
      <AdditionalLibraryDirectories>$(OnyxDeps)lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>azahar_all.lib;onyx_shell.lib;rcheevos.lib;d3d12.lib;dxgi.lib;dxguid.lib;xaudio2.lib;WindowsApp.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <!-- Azahar's libraries and ours both pull in fmt/boost pieces -->
      <AdditionalOptions>%(AdditionalOptions) /IGNORE:4006 /IGNORE:4221</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <Optimization>MaxSpeed</Optimization>
      <IntrinsicFunctions>true</IntrinsicFunctions>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClInclude Include="pch.h" />
    <ClInclude Include="App.h">
      <DependentUpon>App.xaml</DependentUpon>
    </ClInclude>
    <ClInclude Include="MainPage.h">
      <DependentUpon>MainPage.xaml</DependentUpon>
    </ClInclude>
    <ClInclude Include="GamePage.h">
      <DependentUpon>GamePage.xaml</DependentUpon>
    </ClInclude>
    <ClInclude Include="EmulationPage.h">
      <DependentUpon>EmulationPage.xaml</DependentUpon>
    </ClInclude>
    <ClInclude Include="SettingsPage.h">
      <DependentUpon>SettingsPage.xaml</DependentUpon>
    </ClInclude>
    <ClInclude Include="FolderPage.h">
      <DependentUpon>FolderPage.xaml</DependentUpon>
    </ClInclude>
    <ClInclude Include="Emu\AudioOutput.h" />
    <ClInclude Include="Emu\AzaharBridge.h" />
    <ClInclude Include="Emu\D3D12Presenter.h" />
    <ClInclude Include="Emu\EmulatorSession.h" />
    <ClInclude Include="Emu\InputManager.h" />
    <ClInclude Include="Emu\GlHost.h" />
    <ClInclude Include="Emu\VulkanHost.h" />
    <ClInclude Include="Platform\CrashHandler.h" />
    <ClInclude Include="Platform\Profiler.h" />
    <ClInclude Include="Platform\Imaging.h" />
    <ClInclude Include="Platform\Log.h" />
    <ClInclude Include="Platform\UwpPlatform.h" />
    <ClInclude Include="Platform\SaveBackup.h" />
    <ClInclude Include="Ui\AppServices.h" />
    <ClInclude Include="Ui\UiKit.h" />
  </ItemGroup>
  <ItemGroup>
    <ApplicationDefinition Include="App.xaml">
      <SubType>Designer</SubType>
    </ApplicationDefinition>
    <Page Include="MainPage.xaml">
      <SubType>Designer</SubType>
    </Page>
    <Page Include="GamePage.xaml">
      <SubType>Designer</SubType>
    </Page>
    <Page Include="EmulationPage.xaml">
      <SubType>Designer</SubType>
    </Page>
    <Page Include="SettingsPage.xaml">
      <SubType>Designer</SubType>
    </Page>
    <Page Include="FolderPage.xaml">
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="pch.cpp">
      <PrecompiledHeader>Create</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="App.cpp">
      <DependentUpon>App.xaml</DependentUpon>
    </ClCompile>
    <ClCompile Include="MainPage.cpp">
      <DependentUpon>MainPage.xaml</DependentUpon>
    </ClCompile>
    <ClCompile Include="GamePage.cpp">
      <DependentUpon>GamePage.xaml</DependentUpon>
    </ClCompile>
    <ClCompile Include="EmulationPage.cpp">
      <DependentUpon>EmulationPage.xaml</DependentUpon>
    </ClCompile>
    <ClCompile Include="SettingsPage.cpp">
      <DependentUpon>SettingsPage.xaml</DependentUpon>
    </ClCompile>
    <ClCompile Include="FolderPage.cpp">
      <DependentUpon>FolderPage.xaml</DependentUpon>
    </ClCompile>
    <ClCompile Include="$(GeneratedFilesDir)module.g.cpp" />
    <ClCompile Include="Emu\AudioOutput.cpp" />
    <ClCompile Include="Emu\D3D12Presenter.cpp" />
    <ClCompile Include="Emu\GlHost.cpp" />
    <ClCompile Include="Emu\EmulatorSession.cpp" />
    <ClCompile Include="Emu\InputManager.cpp" />
    <ClCompile Include="Emu\VulkanHost.cpp" />
    <ClCompile Include="Platform\CrashHandler.cpp" />
    <ClCompile Include="Platform\Profiler.cpp" />
    <ClCompile Include="Platform\Imaging.cpp" />
    <ClCompile Include="Platform\Log.cpp" />
    <ClCompile Include="Platform\UwpPlatform.cpp" />
    <ClCompile Include="Platform\SaveBackup.cpp" />
    <ClCompile Include="Ui\AppServices.cpp" />
    <ClCompile Include="Ui\UiKit.cpp" />
  </ItemGroup>
  <ItemGroup>
    <Midl Include="ONYX3DS.idl" />
  </ItemGroup>
  <ItemGroup>
    <!-- Presenter shaders, compiled to headers (g_PresentVS / g_PresentPS) -->
    <FxCompile Include="Shaders\PresentVS.hlsl">
      <ShaderType>Vertex</ShaderType>
      <ShaderModel>5.1</ShaderModel>
      <EntryPointName>main</EntryPointName>
      <VariableName>g_%(Filename)</VariableName>
      <HeaderFileOutput>$(IntDir)%(Filename).h</HeaderFileOutput>
      <ObjectFileOutput />
    </FxCompile>
    <FxCompile Include="Shaders\PresentPS.hlsl">
      <ShaderType>Pixel</ShaderType>
      <ShaderModel>5.1</ShaderModel>
      <EntryPointName>main</EntryPointName>
      <VariableName>g_%(Filename)</VariableName>
      <HeaderFileOutput>$(IntDir)%(Filename).h</HeaderFileOutput>
      <ObjectFileOutput />
    </FxCompile>
    <None Include="Shaders\PresentCommon.hlsli" />
  </ItemGroup>
  <ItemGroup>
    <Image Include="Assets\SplashScreen.png" />
    <Image Include="Assets\SplashScreen.scale-200.png" />
    <Image Include="Assets\Square150x150Logo.png" />
    <Image Include="Assets\Square44x44Logo.png" />
    <Image Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Image Include="Assets\StoreLogo.png" />
    <Image Include="Assets\Wide310x150Logo.png" />
    <!-- C++ app packaging picks up None/Image items with DeploymentContent. -->
    <None Include="Assets\Themes\**\*">
      <DeploymentContent>true</DeploymentContent>
    </None>
    <None Include="Assets\Audio\**\*">
      <DeploymentContent>true</DeploymentContent>
    </None>
    <None Include="Assets\Fonts\**\*">
      <DeploymentContent>true</DeploymentContent>
    </None>
    <!-- Native drivers loaded with LoadPackagedLibrary; build-app.ps1 copies
         them here from deps\bin so they land at the package root. -->
    <None Include="vulkan_dzn.dll" Condition="Exists('vulkan_dzn.dll')">
      <DeploymentContent>true</DeploymentContent>
    </None>
    <None Include="dxil.dll" Condition="Exists('dxil.dll')">
      <DeploymentContent>true</DeploymentContent>
    </None>
    <!-- OpenGL on D3D12 (vendor\mesa-gl), for the OpenGL hardware renderer. -->
    <None Include="opengl32.dll" Condition="Exists('opengl32.dll')">
      <DeploymentContent>true</DeploymentContent>
    </None>
    <None Include="libgallium_wgl.dll" Condition="Exists('libgallium_wgl.dll')">
      <DeploymentContent>true</DeploymentContent>
    </None>
    <None Include="z-1.dll" Condition="Exists('z-1.dll')">
      <DeploymentContent>true</DeploymentContent>
    </None>
    <!-- NES core (FCEUmm, vendor\fceumm), optional: build-app.ps1 copies it here when CI built it. -->
    <None Include="fceumm_libretro.dll" Condition="Exists('fceumm_libretro.dll')">
      <DeploymentContent>true</DeploymentContent>
    </None>
  </ItemGroup>
  <ItemGroup>
    <None Include="packages.config" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
    <Import Project="..\packages\Microsoft.Windows.CppWinRT.2.0.240405.15\build\native\Microsoft.Windows.CppWinRT.targets" Condition="Exists('..\packages\Microsoft.Windows.CppWinRT.2.0.240405.15\build\native\Microsoft.Windows.CppWinRT.targets')" />
  </ImportGroup>
  <Target Name="EnsureNuGetPackageBuildImports" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <ErrorText>Run "nuget restore" (tools\build-app.ps1 does this) to fetch C++/WinRT: {0}</ErrorText>
    </PropertyGroup>
    <Error Condition="!Exists('..\packages\Microsoft.Windows.CppWinRT.2.0.240405.15\build\native\Microsoft.Windows.CppWinRT.props')" Text="$([System.String]::Format('$(ErrorText)', '..\packages\Microsoft.Windows.CppWinRT.2.0.240405.15\build\native\Microsoft.Windows.CppWinRT.props'))" />
  </Target>
</Project>
