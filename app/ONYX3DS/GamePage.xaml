<Page
    x:Class="ONYX3DS.GamePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Channel preview: big artwork, title, and what you can do with the game. -->
    <Grid x:Name="Root" Background="Black">
        <Image x:Name="HeroImage" Stretch="UniformToFill" />
        <Rectangle x:Name="Shade" />
        <Grid Margin="96,60,96,54">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="InfoPanel" VerticalAlignment="Bottom" Spacing="18" MaxWidth="1100"
                        HorizontalAlignment="Left" />
            <ScrollViewer x:Name="SideScroll" Grid.Column="1" Width="640" Margin="40,0,0,0"
                          VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel x:Name="SidePanel" Spacing="10" />
            </ScrollViewer>
        </Grid>
        <StackPanel x:Name="ToastHost" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,48,96,0" IsHitTestVisible="False" />
    </Grid>
</Page>
