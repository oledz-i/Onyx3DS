<Page
    x:Class="ONYX3DS.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled">

    <!-- The home menu. Layers back to front: background, two parallax light
         layers, a shadow receiver, the channel grid, the bottom bar. Tiles,
         page dots and the empty state are built in MainPage.cpp. -->
    <Grid x:Name="Root" Background="Black">
        <Image x:Name="BackgroundImage" Stretch="UniformToFill" />
        <Image x:Name="FarLayer" Stretch="UniformToFill" Margin="-80" IsHitTestVisible="False" />
        <Image x:Name="NearLayer" Stretch="UniformToFill" Margin="-120" IsHitTestVisible="False" />
        <Grid x:Name="ShadowReceiver" />
        <!-- Slow floating motes of light; built and animated in MainPage.cpp. -->
        <Canvas x:Name="Sparkles" IsHitTestVisible="False" />

        <Grid x:Name="ContentArea" Margin="96,36,96,236">
            <Grid.RowDefinitions>
                <RowDefinition Height="84" />
                <RowDefinition Height="*" />
                <RowDefinition Height="36" />
            </Grid.RowDefinitions>
            <Grid x:Name="Header">
                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <Border x:Name="MarkHost" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="ONYX 3DS" FontSize="34" FontWeight="SemiBold" />
                        <TextBlock x:Name="GreetingText" FontSize="18" />
                    </StackPanel>
                    <!-- 3DS | NES tabs, built in MainPage.cpp (hidden when the NES core is not in the package). -->
                    <Border x:Name="SystemTabsHost" VerticalAlignment="Center" Margin="28,0,0,0"
                            Visibility="Collapsed" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="1000">
                    <TextBlock x:Name="SelectedText" FontSize="28" FontWeight="SemiBold"
                               HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="InfoText" FontSize="18" HorizontalAlignment="Right"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
            <Grid x:Name="ChannelGrid" Grid.Row="1" XYFocusKeyboardNavigation="Enabled" />
            <StackPanel x:Name="PageDots" Grid.Row="2" Orientation="Horizontal" Spacing="14"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Margin="0,0,0,160" MaxWidth="1100" />

        <Grid x:Name="BottomBar" VerticalAlignment="Bottom" Height="230">
            <Image x:Name="BarImage" Stretch="Fill" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,40">
                <TextBlock x:Name="ClockText" FontSize="72" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock x:Name="DateText" FontSize="26" HorizontalAlignment="Center" />
            </StackPanel>
            <Grid x:Name="LeftButtonHost" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="96,0,0,30" />
            <Grid x:Name="RightButtonHost" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,96,30" />
            <TextBlock x:Name="HintText" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                       Margin="0,0,0,12" Opacity="0.75" Visibility="Collapsed" />
            <Border x:Name="HintHost" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,8" Opacity="0.9" />
        </Grid>

        <StackPanel x:Name="ToastHost" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,96,96,0" IsHitTestVisible="False" />
    </Grid>
</Page>
