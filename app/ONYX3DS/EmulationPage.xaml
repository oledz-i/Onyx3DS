<Page
    x:Class="ONYX3DS.EmulationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Black">

    <Grid x:Name="Root" Background="Black">
        <!-- D3D12Presenter draws the game here. -->
        <SwapChainPanel x:Name="Panel" />
        <!-- Software renderer frames, shown by XAML itself (independent of the swap chain). -->
        <Image x:Name="SoftwareView" Stretch="Uniform" IsHitTestVisible="False" Visibility="Collapsed" />

        <TextBlock x:Name="FpsText" Margin="40,28,0,0" FontSize="20" FontFamily="Consolas"
                   Foreground="#E6FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top"
                   Visibility="Collapsed" IsHitTestVisible="False" />
        <StackPanel x:Name="ToastHost" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,36,48,0" IsHitTestVisible="False" />

        <!-- Shown while the game boots (shader cache, first frame). -->
        <Grid x:Name="LoadingOverlay" Background="#F0050608">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24">
                <Image x:Name="LoadingIcon" Width="144" Height="144" />
                <TextBlock x:Name="LoadingTitle" FontSize="40" FontWeight="SemiBold" Foreground="White"
                           HorizontalAlignment="Center" TextAlignment="Center" />
                <ProgressRing IsActive="True" Width="56" Height="56" Foreground="White" />
                <TextBlock x:Name="LoadingHint" FontSize="20" Foreground="#B0FFFFFF"
                           HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="1100"
                           TextWrapping="WrapWholeWords" />
            </StackPanel>
        </Grid>

        <!-- The ONYX menu (View + Menu): a home-menu style band over the game. -->
        <Grid x:Name="MenuOverlay" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border x:Name="MenuTopBand" Padding="96,32,96,28">
                <Grid>
                    <TextBlock x:Name="MenuTitle" FontSize="34" FontWeight="SemiBold" />
                    <TextBlock x:Name="MenuClock" FontSize="28" HorizontalAlignment="Right" />
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="96,24,96,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="MenuButtons" VerticalAlignment="Center" Spacing="16" />
                <ScrollViewer x:Name="MenuSideScroll" Grid.Column="1" Width="660" Margin="40,0,0,0"
                              VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel x:Name="MenuSide" Spacing="8" />
                </ScrollViewer>
            </Grid>
            <Border x:Name="MenuBottomBand" Grid.Row="2" Padding="96,20,96,24">
                <TextBlock x:Name="MenuHint" FontSize="20" />
            </Border>
        </Grid>
    </Grid>
</Page>
